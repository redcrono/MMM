---
export interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  type?: 'primary' | 'success' | 'amber';
}

const { title, subtitle, badge = '핵심 인포그래픽', type = 'primary' } = Astro.props;

const borderColors = {
  primary: 'var(--primary)',
  success: 'var(--secondary)',
  amber: 'var(--accent-amber)',
};

const bgColors = {
  primary: 'var(--primary-light)',
  success: 'var(--secondary-light)',
  amber: 'var(--accent-amber-light)',
};
---

<figure class="infographic-container" style={`margin: 2.5rem 0; background: var(--bg-card); border: 2px solid ${borderColors[type]}; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md);`}>
  <div style={`background: ${bgColors[type]}; padding: 0.85rem 1.25rem; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;`}>
    <div>
      <span style={`font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: ${borderColors[type]}; letter-spacing: 0.05em; display: block; margin-bottom: 0.15rem;`}>
        📊 {badge}
      </span>
      <figcaption style="font-size: 1.05rem; font-weight: 800; color: var(--text-main); margin: 0;">
        {title}
      </figcaption>
    </div>
    {subtitle && <span style="font-size: 0.8rem; color: var(--text-muted);">{subtitle}</span>}
  </div>
  <div style="padding: 1.5rem;">
    <slot />
  </div>
</figure>
