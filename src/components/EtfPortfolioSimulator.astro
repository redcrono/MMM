---
interface Props {
  isEn?: boolean;
}

const { isEn = false } = Astro.props;
---

<div class="etf-sim-container" id="etf-simulator-app" data-is-en={isEn ? "true" : "false"}>
  <!-- Simulator Header -->
  <div class="sim-header">
    <div class="sim-badge">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
      </svg>
      <span>{isEn ? 'FinTech Quantitative Engine' : '글로벌 퀀트 핀테크 엔진'}</span>
    </div>
    <h2 class="sim-title">
      {isEn ? 'ETF Multi-Asset Portfolio & Dividend Compound Simulator' : '글로벌 ETF 포트폴리오 & 배당 복리 퀀트 시뮬레이터'}
    </h2>
    <p class="sim-subtitle">
      {isEn
        ? 'Simulate your future portfolio compounding across 1~30 years with Covered Calls & 20M KRW Comprehensive Financial Taxation engine, or backtest historical past returns.'
        : 'S&P500·나스닥부터 최신 JEPQ·타겟 데일리 커버드콜까지! 2,000만 원 초과 금융소득종합과세와 건보료 피부양자 박탈 기준까지 1원 단위로 정밀 시뮬레이션하세요.'}
    </p>

    <!-- Master Mode Tabs -->
    <div class="master-tab-wrap">
      <button type="button" class="master-tab-btn active" id="tab-future-btn" data-target="future-view">
        <span class="m-tab-icon">🔮</span>
        <span class="m-tab-title">{isEn ? 'Future Projection Simulator' : '미래 1~30년 복리 & 월배당 예측'}</span>
        <span class="m-tab-sub">{isEn ? 'Forecast forward asset growth & monthly dividend' : '커버드콜·금융소득종합과세(2천만) 정밀 시뮬레이션'}</span>
      </button>
      <button type="button" class="master-tab-btn" id="tab-history-btn" data-target="history-view">
        <span class="m-tab-icon">⏳</span>
        <span class="m-tab-title">{isEn ? 'Historical Time Machine Backtest' : '과거 1~30년 타임머신 실측 백테스트'}</span>
        <span class="m-tab-sub">{isEn ? 'Actual past returns, dividends paid & taxes withheld' : '실제 과거 배당금 입금일, 세금 차감, MDD 실측'}</span>
      </button>
    </div>
  </div>

  <!-- VIEW 1: FORWARD PROJECTION SIMULATOR -->
  <div class="sim-view-section active" id="future-view">
    <!-- Preset Strategy Selector -->
    <div class="preset-section">
      <div class="preset-label">{isEn ? '⚡ Select Strategy Preset:' : '⚡ 인기 대표 전략 프리셋 선택:'}</div>
      <div class="preset-buttons">
        <button type="button" class="preset-btn" data-preset="growth">
          <span class="p-icon">🚀</span>
          <span class="p-text">{isEn ? 'US Growth Engine' : '미국 지수 성장형'}</span>
          <span class="p-sub">{isEn ? 'S&P500 50% + QQQ 50%' : 'S&P500 50% + 나스닥 50%'}</span>
        </button>
        <button type="button" class="preset-btn active" data-preset="coveredcall">
          <span class="p-icon">⚡</span>
          <span class="p-text">{isEn ? '2026 Covered Call Cashflow' : '초고배당 커버드콜 월급형'}</span>
          <span class="p-sub">{isEn ? 'JEPQ 50% + Target Daily CC 50%' : 'JEPQ 50% + 타겟 데일리 50% (월배당 11%)'}</span>
        </button>
        <button type="button" class="preset-btn" data-preset="fire">
          <span class="p-icon">🏖️</span>
          <span class="p-text">{isEn ? 'Monthly Dividend FIRE' : '월배당 파이어족'}</span>
          <span class="p-sub">{isEn ? 'SCHD 60% + JEPI 40%' : 'SCHD 60% + JEPI 40%'}</span>
        </button>
        <button type="button" class="preset-btn" data-preset="allweather">
          <span class="p-icon">🛡️</span>
          <span class="p-text">{isEn ? 'All-Weather Balanced' : '올웨더 자산배분'}</span>
          <span class="p-sub">{isEn ? 'Stock 50% + Div 20% + Gold 15% + CC 15%' : '주식 50% + 배당 20% + 금 15% + 커버드콜 15%'}</span>
        </button>
        <button type="button" class="preset-btn" data-preset="productive">
          <span class="p-icon">🇰🇷</span>
          <span class="p-text">{isEn ? '2026 Productive ISA' : '2026 생산적 ISA형'}</span>
          <span class="p-sub">{isEn ? 'K-ValueUp 50% + US Growth 50%' : 'K-밸류업 50% + 미국성장 50%'}</span>
        </button>
      </div>
    </div>

    <div class="sim-main-grid">
      <!-- Left: Investment Inputs & Allocation Sliders -->
      <div class="sim-card-panel">
        <h3 class="panel-heading">
          <span>⚙️</span> {isEn ? 'Investment Capital & Conditions' : '1. 투자 원금 및 세금 조건 설정'}
        </h3>

        <!-- Initial Capital -->
        <div class="form-group">
          <div class="form-label-row">
            <label for="initial-amount-range">{isEn ? 'Initial Lump Sum:' : '초기 투자 원금:'}</label>
            <span class="highlight-val" id="initial-val-display">2,000만 원</span>
          </div>
          <div class="input-range-wrap">
            <input type="range" id="initial-amount-range" min="0" max="20000" step="100" value="2000" class="sim-range" />
          </div>
        </div>

        <!-- Monthly Contribution -->
        <div class="form-group">
          <div class="form-label-row">
            <label for="monthly-amount-range">{isEn ? 'Monthly Contribution (DCA):' : '매월 정기 적립액:'}</label>
            <span class="highlight-val" id="monthly-val-display">100만 원 / 월</span>
          </div>
          <div class="input-range-wrap">
            <input type="range" id="monthly-amount-range" min="0" max="500" step="10" value="100" class="sim-range" />
          </div>
        </div>

        <!-- Horizon Years -->
        <div class="form-group">
          <div class="form-label-row">
            <label for="years-range">{isEn ? 'Investment Horizon:' : '투자 기간:'}</label>
            <span class="highlight-val" id="years-val-display">10년</span>
          </div>
          <div class="input-range-wrap">
            <input type="range" id="years-range" min="1" max="30" step="1" value="10" class="sim-range" />
          </div>
        </div>

        <!-- Dividend Policy & Account Selection -->
        <div class="option-grid">
          <div class="option-item">
            <label class="option-title">{isEn ? 'Dividend Policy:' : '배당금 운용 방식'}</label>
            <div class="toggle-pill-wrap">
              <button type="button" class="toggle-pill-btn active" id="drip-on-btn" data-drip="true">
                🔄 {isEn ? 'DRIP Reinvest' : '배당 전액 재투자'}
              </button>
              <button type="button" class="toggle-pill-btn" id="drip-off-btn" data-drip="false">
                💵 {isEn ? 'Cash Payout' : '매월 현금 수령'}
              </button>
            </div>
          </div>

          <div class="option-item">
            <label class="option-title">{isEn ? 'Account Tax Type:' : '투자 계좌 유형'}</label>
            <select id="account-type-select" class="sim-select">
              <option value="general">{isEn ? 'Standard Account (15.4% ~ Comprehensive Tax)' : '일반 과세 계좌 (2천만 초과 시 종소세 합산)'}</option>
              <option value="isa" selected>{isEn ? 'Brokerage / Productive ISA (Tax Shield)' : '중개형·생산적 ISA (종합과세 100% 면제 쉴드)'}</option>
              <option value="pension">{isEn ? 'Pension Savings / IRP (100% Tax-Deferred)' : '연금저축·IRP 계좌 (운용 중 세금 0원 & 과세이연)'}</option>
            </select>
          </div>
        </div>

        <!-- Comprehensive Income Tax Bracket Setting -->
        <div class="form-group" style="background: var(--bg-card); padding: 0.85rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
          <label class="option-title" style="color: var(--text-main); font-weight: 800; margin-bottom: 0.35rem;">
            💼 {isEn ? 'Other Taxable Income (Salary/Business):' : '나의 근로·사업 과세표준 (금융소득종합과세 시 적용세율)'}
          </label>
          <select id="salary-bracket-select" class="sim-select">
            <option value="0.066">{isEn ? '14M KRW or less (Marginal Tax: 6.6%)' : '1,400만 원 이하 (한계세율 6.6%)'}</option>
            <option value="0.165">{isEn ? '14M ~ 50M KRW (Marginal Tax: 16.5%)' : '1,400만 ~ 5,000만 원 (한계세율 16.5%)'}</option>
            <option value="0.264" selected>{isEn ? '50M ~ 88M KRW (Marginal Tax: 26.4% - Standard)' : '5,000만 ~ 8,800만 원 (한계세율 26.4% - 평균 직장인)'}</option>
            <option value="0.385">{isEn ? '88M ~ 150M KRW (Marginal Tax: 38.5%)' : '8,800만 ~ 1억 5,000만 원 (한계세율 38.5%)'}</option>
            <option value="0.418">{isEn ? '150M ~ 300M KRW (Marginal Tax: 41.8%)' : '1억 5,000만 ~ 3억 원 (한계세율 41.8%)'}</option>
          </select>
          <p style="font-size: 0.725rem; color: var(--text-muted); margin: 0.4rem 0 0 0;">
            * 연간 배당금이 2,000만 원을 초과할 때 일반 계좌는 위 한계세율로 종합과세되며 건강보험료 피부양자에서 박탈됩니다. (ISA/연금계좌는 전액 방어)
          </p>
        </div>

        <!-- Asset Allocation Sliders -->
        <div class="allocation-section">
          <div class="alloc-header">
            <span class="alloc-title">📊 {isEn ? '2. ETF Asset Allocation' : '2. ETF 자산 비중 배분 (커버드콜 포함)'}</span>
            <span class="alloc-total-badge" id="alloc-total-badge">합계: 100%</span>
          </div>

          <!-- ETF Sliders List -->
          <div class="etf-slider-list">
            <!-- JEPQ (Nasdaq Covered Call) -->
            <div class="etf-slider-item highlight-slider">
              <div class="etf-meta">
                <span class="etf-name">⚡ JEPQ (JPMorgan 나스닥 커버드콜)</span>
                <span class="etf-cagr">CAGR 11.5% | 월배당 10.5%</span>
                <span class="etf-pct" id="pct-jepq">50%</span>
              </div>
              <input type="range" class="etf-range" id="range-jepq" min="0" max="100" step="5" value="50" />
            </div>

            <!-- Target Daily Covered Call -->
            <div class="etf-slider-item highlight-slider">
              <div class="etf-meta">
                <span class="etf-name">⚡ 타겟 데일리 커버드콜 (미국배당/나스닥+7~15%)</span>
                <span class="etf-cagr">CAGR 9.5% | 월배당 12.0%</span>
                <span class="etf-pct" id="pct-dailycc">50%</span>
              </div>
              <input type="range" class="etf-range" id="range-dailycc" min="0" max="100" step="5" value="50" />
            </div>

            <!-- Ultra High Yield Option Income -->
            <div class="etf-slider-item">
              <div class="etf-meta">
                <span class="etf-name">🔥 초고배당 옵션 인컴 (CONY / NVDY / TLTW)</span>
                <span class="etf-cagr">CAGR 6.0% | 초고배당 24.0%</span>
                <span class="etf-pct" id="pct-ultra">0%</span>
              </div>
              <input type="range" class="etf-range" id="range-ultra" min="0" max="100" step="5" value="0" />
            </div>

            <!-- SCHD -->
            <div class="etf-slider-item">
              <div class="etf-meta">
                <span class="etf-name">🇺🇸 SCHD (미국배당다우존스)</span>
                <span class="etf-cagr">CAGR 11.2% | 배당 3.6% (성장 10%)</span>
                <span class="etf-pct" id="pct-schd">0%</span>
              </div>
              <input type="range" class="etf-range" id="range-schd" min="0" max="100" step="5" value="0" />
            </div>

            <!-- JEPI -->
            <div class="etf-slider-item">
              <div class="etf-meta">
                <span class="etf-name">🇺🇸 JEPI (JPMorgan S&P500 커버드콜)</span>
                <span class="etf-cagr">CAGR 7.5% | 월배당 8.5%</span>
                <span class="etf-pct" id="pct-jepi">0%</span>
              </div>
              <input type="range" class="etf-range" id="range-jepi" min="0" max="100" step="5" value="0" />
            </div>

            <!-- S&P 500 -->
            <div class="etf-slider-item">
              <div class="etf-meta">
                <span class="etf-name">🇺🇸 S&P 500 (VOO / SPLG)</span>
                <span class="etf-cagr">CAGR 10.5% | 배당 1.5%</span>
                <span class="etf-pct" id="pct-sp500">0%</span>
              </div>
              <input type="range" class="etf-range" id="range-sp500" min="0" max="100" step="5" value="0" />
            </div>

            <!-- Nasdaq 100 -->
            <div class="etf-slider-item">
              <div class="etf-meta">
                <span class="etf-name">🇺🇸 Nasdaq 100 (QQQ / QQQM)</span>
                <span class="etf-cagr">CAGR 14.8% | 배당 0.6%</span>
                <span class="etf-pct" id="pct-nasdaq">0%</span>
              </div>
              <input type="range" class="etf-range" id="range-nasdaq" min="0" max="100" step="5" value="0" />
            </div>

            <!-- K-ValueUp -->
            <div class="etf-slider-item">
              <div class="etf-meta">
                <span class="etf-name">🇰🇷 K-ValueUp & 국내 고배당</span>
                <span class="etf-cagr">CAGR 8.5% | 배당 4.2%</span>
                <span class="etf-pct" id="pct-kvalue">0%</span>
              </div>
              <input type="range" class="etf-range" id="range-kvalue" min="0" max="100" step="5" value="0" />
            </div>

            <!-- Gold -->
            <div class="etf-slider-item">
              <div class="etf-meta">
                <span class="etf-name">🥇 Gold (KRX 금현물 / GLD)</span>
                <span class="etf-cagr">CAGR 8.2% | 무배당</span>
                <span class="etf-pct" id="pct-gold">0%</span>
              </div>
              <input type="range" class="etf-range" id="range-gold" min="0" max="100" step="5" value="0" />
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Real-time Simulation Results Dashboard -->
      <div class="sim-result-panel">
        <h3 class="panel-heading">
          <span>📈</span> {isEn ? 'Simulation Output & Projection' : '시뮬레이션 결과 대시보드'}
        </h3>

        <!-- Big Metric: Final Portfolio Value -->
        <div class="metric-hero-card">
          <div class="m-hero-label">{isEn ? 'Projected Total Asset Value:' : '최종 예상 총 자산 평가액'}</div>
          <div class="m-hero-value" id="res-total-asset">0원</div>
          <div class="m-hero-sub" id="res-principal-profit">
            총 납입 원금: 0원 | 순수익: +0원 (+0%)
          </div>
        </div>

        <!-- 20M Financial Income Tax & Shield Live Banner -->
        <div class="tax-shield-card" id="tax-shield-card">
          <div class="ts-icon" id="ts-icon">🛡️</div>
          <div class="ts-content">
            <div class="ts-title" id="ts-title">금융소득 2,000만 원 이하 안전 구간</div>
            <div class="ts-desc" id="ts-desc">배당소득세 15.4% 분리과세 종결 및 건강보험료 피부양자 안전 유지</div>
          </div>
        </div>

        <!-- Secondary Metric Grid -->
        <div class="metric-sub-grid">
          <!-- Monthly Passive Dividend Income -->
          <div class="sub-metric-card">
            <div class="sm-icon">💵</div>
            <div class="sm-info">
              <span class="sm-label">{isEn ? 'Monthly Passive Dividend:' : '만기 시점 예상 월 배당금'}</span>
              <span class="sm-val" id="res-monthly-dividend">0원 / 월</span>
              <span class="sm-note" id="res-annual-dividend">연간 배당금: 0원</span>
            </div>
          </div>

          <!-- Tax Savings Alpha -->
          <div class="sub-metric-card highlight-card">
            <div class="sm-icon">🛡️</div>
            <div class="sm-info">
              <span class="sm-label">{isEn ? 'Taxes Saved via ISA/Pension:' : '절세계좌 활용 세금 절감액'}</span>
              <span class="sm-val" id="res-tax-saved">+0원</span>
              <span class="sm-note" id="res-tax-note">{isEn ? 'vs General Account' : '일반 계좌 대비 세후 추가 수익'}</span>
            </div>
          </div>
        </div>

        <!-- Growth Chart Visualizer -->
        <div class="chart-container">
          <div class="chart-header">
            <span class="chart-title">📊 {isEn ? 'Asset Growth Trajectory' : '연도별 자산 증식 궤적 (원금 vs 수익)'}</span>
            <span class="chart-legend">
              <span class="dot dot-principal"></span> {isEn ? 'Principal' : '납입 원금'}
              <span class="dot dot-profit"></span> {isEn ? 'Compound Profit' : '복리 순수익'}
            </span>
          </div>
          <div class="chart-bars-wrap" id="chart-bars-wrap">
            <!-- Dynamically populated bars -->
          </div>
        </div>

        <!-- Year-by-Year Milestone Table -->
        <div class="table-container">
          <h4 class="table-title">📑 {isEn ? 'Milestone Breakdown Table' : '주요 연도별 자산 및 세무 마일스톤'}</h4>
          <div class="table-scroll">
            <table class="milestone-table">
              <thead>
                <tr>
                  <th>{isEn ? 'Year' : '경과 기간'}</th>
                  <th>{isEn ? 'Principal' : '누적 원금'}</th>
                  <th>{isEn ? 'Total Asset' : '총 자산'}</th>
                  <th>{isEn ? 'Monthly Div' : '월 배당금'}</th>
                  <th>{isEn ? 'Annual Div' : '연간 배당금'}</th>
                  <th>{isEn ? 'Tax Status' : '세무 상태'}</th>
                </tr>
              </thead>
              <tbody id="milestone-table-body">
                <!-- Dynamically populated rows -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- VIEW 2: HISTORICAL TIME MACHINE BACKTEST (PAST 1~30 YEARS) -->
  <div class="sim-view-section" id="history-view">
    <div class="time-machine-banner">
      <div class="tm-banner-icon">⏳</div>
      <div class="tm-banner-text">
        <h3 class="tm-banner-title">
          {isEn ? 'Historical Time Machine Backtest Engine (1996 ~ 2026)' : '과거 1~30년 타임머신 실측 백테스터 (1996년~2026년)'}
        </h3>
        <p class="tm-banner-desc">
          {isEn
            ? 'Test what would have happened if you invested in real ETFs 1, 2, 3, 5, 10, 20, or 30 years ago. Analyzes actual historical stock prices, dividends received, and 15.4% taxes withheld.'
            : '실제로 1년, 3년, 5년, 10년, 20년, 최대 30년 전에 투자했더라면 지금까지 실제 분기별 배당금이 얼마 들어오고, 세금이 얼마 떼였으며, 현재 계좌 잔고가 얼마인지 과거 실적으로 정밀 복기합니다.'}
        </p>
      </div>
    </div>

    <!-- Quick Past Horizon Selector -->
    <div class="hist-horizon-section">
      <div class="hist-label">{isEn ? '⚡ Select Investment Start Point in the Past:' : '⚡ 과거 투자 시작 시점 선택 (최장 30년):'}</div>
      <div class="hist-btn-grid">
        <button type="button" class="hist-quick-btn" data-years="1">1년 전 (2025)</button>
        <button type="button" class="hist-quick-btn" data-years="2">2년 전 (2024)</button>
        <button type="button" class="hist-quick-btn" data-years="3">3년 전 (2023)</button>
        <button type="button" class="hist-quick-btn" data-years="5">5년 전 (2021)</button>
        <button type="button" class="hist-quick-btn" data-years="7">7년 전 (2019)</button>
        <button type="button" class="hist-quick-btn active" data-years="10">10년 전 (2016)</button>
        <button type="button" class="hist-quick-btn" data-years="15">15년 전 (2011/SCHD상장)</button>
        <button type="button" class="hist-quick-btn" data-years="20">20년 전 (2006/금융위기전)</button>
