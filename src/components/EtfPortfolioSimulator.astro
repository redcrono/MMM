  function initApp() {
    const container = document.getElementById('etf-simulator-app');
    if (!container) return;

    const isEn = container.getAttribute('data-is-en') === 'true';

    // Top Master Tab Switching
    const tabFutureBtn = document.getElementById('tab-future-btn');
    const tabHistoryBtn = document.getElementById('tab-history-btn');
    const futureView = document.getElementById('future-view');
    const historyView = document.getElementById('history-view');

    tabFutureBtn?.addEventListener('click', () => {
      tabFutureBtn.classList.add('active');
      tabHistoryBtn?.classList.remove('active');
      futureView?.classList.add('active');
      historyView?.classList.remove('active');
    });

    tabHistoryBtn?.addEventListener('click', () => {
      tabHistoryBtn.classList.add('active');
      tabFutureBtn?.classList.remove('active');
      historyView?.classList.add('active');
      futureView?.classList.remove('active');
      calculateHistoricalBacktest();
    });

    // -------------------------------------------------------------
    // 1. FORWARD PROJECTION LOGIC
    // -------------------------------------------------------------
    const initialRange = document.getElementById('initial-amount-range') as HTMLInputElement;
    const initialDisplay = document.getElementById('initial-val-display');
    const monthlyRange = document.getElementById('monthly-amount-range') as HTMLInputElement;
    const monthlyDisplay = document.getElementById('monthly-val-display');
    const yearsRange = document.getElementById('years-range') as HTMLInputElement;
    const yearsDisplay = document.getElementById('years-val-display');
    const accountSelect = document.getElementById('account-type-select') as HTMLSelectElement;
    const salarySelect = document.getElementById('salary-bracket-select') as HTMLSelectElement;

    const dripOnBtn = document.getElementById('drip-on-btn');
    const dripOffBtn = document.getElementById('drip-off-btn');
    let isDrip = true;

    // Sliders
    const rangeJepq = document.getElementById('range-jepq') as HTMLInputElement;
    const rangeDailyCc = document.getElementById('range-dailycc') as HTMLInputElement;
    const rangeUltra = document.getElementById('range-ultra') as HTMLInputElement;
    const rangeSchd = document.getElementById('range-schd') as HTMLInputElement;
    const rangeJepi = document.getElementById('range-jepi') as HTMLInputElement;
    const rangeSp500 = document.getElementById('range-sp500') as HTMLInputElement;
    const rangeNasdaq = document.getElementById('range-nasdaq') as HTMLInputElement;
    const rangeKvalue = document.getElementById('range-kvalue') as HTMLInputElement;
    const rangeGold = document.getElementById('range-gold') as HTMLInputElement;

    const pctJepq = document.getElementById('pct-jepq');
    const pctDailyCc = document.getElementById('pct-dailycc');
    const pctUltra = document.getElementById('pct-ultra');
    const pctSchd = document.getElementById('pct-schd');
    const pctJepi = document.getElementById('pct-jepi');
    const pctSp500 = document.getElementById('pct-sp500');
    const pctNasdaq = document.getElementById('pct-nasdaq');
    const pctKvalue = document.getElementById('pct-kvalue');
    const pctGold = document.getElementById('pct-gold');
    const allocTotalBadge = document.getElementById('alloc-total-badge');

    // Preset Strategies
    const presetButtons = document.querySelectorAll('.preset-btn');
    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        presetButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const preset = btn.getAttribute('data-preset');
        if (preset === 'coveredcall') setSliders(50, 50, 0, 0, 0, 0, 0, 0, 0);
        else if (preset === 'growth') setSliders(0, 0, 0, 0, 0, 50, 50, 0, 0);
        else if (preset === 'fire') setSliders(0, 0, 0, 60, 40, 0, 0, 0, 0);
        else if (preset === 'allweather') setSliders(15, 0, 0, 20, 0, 30, 20, 0, 15);
        else if (preset === 'productive') setSliders(0, 0, 0, 0, 0, 25, 25, 50, 0);
        calculateForwardSimulation();
      });
    });

    function setSliders(jq: number, dc: number, ul: number, sc: number, jp: number, sp: number, nq: number, kv: number, gd: number) {
      if (rangeJepq) rangeJepq.value = jq.toString();
      if (rangeDailyCc) rangeDailyCc.value = dc.toString();
      if (rangeUltra) rangeUltra.value = ul.toString();
      if (rangeSchd) rangeSchd.value = sc.toString();
      if (rangeJepi) rangeJepi.value = jp.toString();
      if (rangeSp500) rangeSp500.value = sp.toString();
      if (rangeNasdaq) rangeNasdaq.value = nq.toString();
      if (rangeKvalue) rangeKvalue.value = kv.toString();
      if (rangeGold) rangeGold.value = gd.toString();
    }

    dripOnBtn?.addEventListener('click', () => {
      isDrip = true;
      dripOnBtn.classList.add('active');
      dripOffBtn?.classList.remove('active');
      calculateForwardSimulation();
    });

    dripOffBtn?.addEventListener('click', () => {
      isDrip = false;
      dripOffBtn.classList.add('active');
      dripOnBtn?.classList.remove('active');
      calculateForwardSimulation();
    });

    [initialRange, monthlyRange, yearsRange, accountSelect, salarySelect].forEach(el => {
      el?.addEventListener('input', calculateForwardSimulation);
    });

    [rangeJepq, rangeDailyCc, rangeUltra, rangeSchd, rangeJepi, rangeSp500, rangeNasdaq, rangeKvalue, rangeGold].forEach(el => {
      el?.addEventListener('input', () => {
        const sum = [rangeJepq, rangeDailyCc, rangeUltra, rangeSchd, rangeJepi, rangeSp500, rangeNasdaq, rangeKvalue, rangeGold]
          .reduce((a, b) => a + parseInt(b?.value || '0', 10), 0);
        if (allocTotalBadge) {
          allocTotalBadge.textContent = isEn ? `Total: ${sum}%` : `합계: ${sum}%`;
          allocTotalBadge.style.color = sum === 100 ? 'var(--secondary)' : 'var(--danger)';
        }
        calculateForwardSimulation();
      });
    });

    function calculateForwardSimulation() {
      const initialWon = parseInt(initialRange?.value || '2000', 10) * 10000;
      const monthlyWon = parseInt(monthlyRange?.value || '100', 10) * 10000;
      const years = parseInt(yearsRange?.value || '10', 10);
      const account = accountSelect?.value || 'isa';
      const marginalTaxRate = parseFloat(salarySelect?.value || '0.264');

      if (initialDisplay) initialDisplay.textContent = formatMoney(initialWon, isEn);
      if (monthlyDisplay) monthlyDisplay.textContent = `${formatMoney(monthlyWon, isEn)}${isEn ? '/mo' : ' / 월'}`;
      if (yearsDisplay) yearsDisplay.textContent = isEn ? `${years} Years` : `${years}년`;

      const wJq = parseInt(rangeJepq?.value || '0', 10);
      const wDc = parseInt(rangeDailyCc?.value || '0', 10);
      const wUl = parseInt(rangeUltra?.value || '0', 10);
      const wSc = parseInt(rangeSchd?.value || '0', 10);
      const wJp = parseInt(rangeJepi?.value || '0', 10);
      const wSp = parseInt(rangeSp500?.value || '0', 10);
      const wNq = parseInt(rangeNasdaq?.value || '0', 10);
      const wKv = parseInt(rangeKvalue?.value || '0', 10);
      const wGd = parseInt(rangeGold?.value || '0', 10);

      if (pctJepq) pctJepq.textContent = `${wJq}%`;
      if (pctDailyCc) pctDailyCc.textContent = `${wDc}%`;
      if (pctUltra) pctUltra.textContent = `${wUl}%`;
      if (pctSchd) pctSchd.textContent = `${wSc}%`;
      if (pctJepi) pctJepi.textContent = `${wJp}%`;
      if (pctSp500) pctSp500.textContent = `${wSp}%`;
      if (pctNasdaq) pctNasdaq.textContent = `${wNq}%`;
      if (pctKvalue) pctKvalue.textContent = `${wKv}%`;
      if (pctGold) pctGold.textContent = `${wGd}%`;

      const sumWeight = wJq + wDc + wUl + wSc + wJp + wSp + wNq + wKv + wGd || 100;
      const fJq = wJq / sumWeight;
      const fDc = wDc / sumWeight;
      const fUl = wUl / sumWeight;
      const fSc = wSc / sumWeight;
      const fJp = wJp / sumWeight;
      const fSp = wSp / sumWeight;
      const fNq = wNq / sumWeight;
      const fKv = wKv / sumWeight;
      const fGd = wGd / sumWeight;

      // Weighted Returns & Dividend Yields
      // JEPQ: Price 1.0%, Div 10.5%, Growth 2.0%
      // DailyCC: Price -2.5%, Div 12.0%, Growth 1.5%
      // Ultra: Price -18.0%, Div 24.0%, Growth 0.0%
      // SCHD: Price 7.6%, Div 3.6%, Growth 10.0%
      // JEPI: Price -1.0%, Div 8.5%, Growth 1.5%
      // S&P: Price 9.0%, Div 1.5%, Growth 7.0%
      // NQ: Price 14.2%, Div 0.6%, Growth 8.5%
      // K-Val: Price 4.3%, Div 4.2%, Growth 7.0%
      // Gold: Price 8.2%, Div 0.0%, Growth 0.0%

      const weightedPriceReturn = (fJq * 0.01) + (fDc * -0.025) + (fUl * -0.18) + (fSc * 0.076) + (fJp * -0.01) + (fSp * 0.09) + (fNq * 0.142) + (fKv * 0.043) + (fGd * 0.082);
      const weightedInitialDiv = (fJq * 0.105) + (fDc * 0.120) + (fUl * 0.240) + (fSc * 0.036) + (fJp * 0.085) + (fSp * 0.015) + (fNq * 0.006) + (fKv * 0.042) + (fGd * 0.0);
      const weightedDivGrowth = (fJq * 0.02) + (fDc * 0.015) + (fUl * 0.0) + (fSc * 0.10) + (fJp * 0.015) + (fSp * 0.07) + (fNq * 0.085) + (fKv * 0.07) + (fGd * 0.0);
      const yieldSpread = Math.max(0, weightedDivGrowth - Math.max(0, weightedPriceReturn));

      let totalAsset = initialWon;
      let totalPrincipal = initialWon;
      let totalDivPaid = 0;
      let totalGeneralTax = 0;
      let totalActualTaxPaid = 0;
      let cumulativeIsaDividends = 0;
      const ISA_TAX_FREE_CAP = 5000000;
      const COMPREHENSIVE_TAX_THRESHOLD = 20000000; // 2천만 원 기준

      let everExceeded20M = false;

      const milestones: Array<{ year: number; principal: number; asset: number; monthlyDiv: number; annualDiv: number; taxStatus: string }> = [];
      const chartPoints: Array<{ year: number; principal: number; profit: number; total: number }> = [];

      const totalMonths = years * 12;

      for (let m = 1; m <= totalMonths; m++) {
        totalAsset += monthlyWon;
        totalPrincipal += monthlyWon;

        const currentYear = Math.floor((m - 1) / 12);
        const effectiveAnnualDivRate = weightedInitialDiv * Math.pow(1 + yieldSpread, currentYear);

        const monthlyPriceRate = Math.pow(1 + weightedPriceReturn, 1 / 12) - 1;
        totalAsset += totalAsset * monthlyPriceRate;

        const grossMonthlyDiv = totalAsset * (effectiveAnnualDivRate / 12);
        const projectedAnnualDiv = grossMonthlyDiv * 12;

        if (projectedAnnualDiv > COMPREHENSIVE_TAX_THRESHOLD) {
          everExceeded20M = true;
        }

        // Tax Engine (including 20M KRW Comprehensive Taxation for General Accounts)
        let appliedTaxRate = 0.154;
        let benchmarkGeneralTax = grossMonthlyDiv * 0.154;

        if (account === 'general') {
          if (projectedAnnualDiv > COMPREHENSIVE_TAX_THRESHOLD) {
            // Portion above 20M is taxed at marginal tax rate
            const standardPortion = COMPREHENSIVE_TAX_THRESHOLD / 12;
            const excessPortion = Math.max(0, grossMonthlyDiv - standardPortion);
            const standardTax = standardPortion * 0.154;
            const excessTax = excessPortion * marginalTaxRate;
            appliedTaxRate = (standardTax + excessTax) / grossMonthlyDiv;
            benchmarkGeneralTax = standardTax + excessTax;
          } else {
            appliedTaxRate = 0.154;
            benchmarkGeneralTax = grossMonthlyDiv * 0.154;
          }
        } else if (account === 'isa') {
          // In General account, it would face comprehensive tax
          if (projectedAnnualDiv > COMPREHENSIVE_TAX_THRESHOLD) {
            const standardPortion = COMPREHENSIVE_TAX_THRESHOLD / 12;
            const excessPortion = Math.max(0, grossMonthlyDiv - standardPortion);
            benchmarkGeneralTax = (standardPortion * 0.154) + (excessPortion * marginalTaxRate);
          } else {
            benchmarkGeneralTax = grossMonthlyDiv * 0.154;
          }

          // But in ISA, 0% up to 5M, then 9.9% separate taxation NO MATTER HOW LARGE!
          if (cumulativeIsaDividends < ISA_TAX_FREE_CAP) {
            const remainingTaxFree = ISA_TAX_FREE_CAP - cumulativeIsaDividends;
            if (grossMonthlyDiv <= remainingTaxFree) {
              appliedTaxRate = 0.0;
              cumulativeIsaDividends += grossMonthlyDiv;
            } else {
              const taxableAmount = grossMonthlyDiv - remainingTaxFree;
              cumulativeIsaDividends += remainingTaxFree;
              appliedTaxRate = (taxableAmount / grossMonthlyDiv) * 0.099;
            }
          } else {
            appliedTaxRate = 0.099;
          }
        } else if (account === 'pension') {
          if (projectedAnnualDiv > COMPREHENSIVE_TAX_THRESHOLD) {
            const standardPortion = COMPREHENSIVE_TAX_THRESHOLD / 12;
            const excessPortion = Math.max(0, grossMonthlyDiv - standardPortion);
            benchmarkGeneralTax = (standardPortion * 0.154) + (excessPortion * marginalTaxRate);
          } else {
            benchmarkGeneralTax = grossMonthlyDiv * 0.154;
          }
          appliedTaxRate = 0.0;
        }

        const netMonthlyDiv = grossMonthlyDiv * (1 - appliedTaxRate);
        const actualTax = grossMonthlyDiv * appliedTaxRate;

        totalGeneralTax += benchmarkGeneralTax;
        totalActualTaxPaid += actualTax;

        if (isDrip) {
          totalAsset += netMonthlyDiv;
        } else {
          totalDivPaid += netMonthlyDiv;
        }

        if (m % 12 === 0 || m === totalMonths) {
          const yr = Math.ceil(m / 12);
          const currentMonthlyDiv = totalAsset * (effectiveAnnualDivRate / 12) * (1 - appliedTaxRate);
          const currentAnnualDiv = totalAsset * effectiveAnnualDivRate;
          let statusText = '안전 (15.4% 이하)';
          if (currentAnnualDiv > COMPREHENSIVE_TAX_THRESHOLD) {
            if (account === 'general') statusText = '🚨 종소세 합산+건보료박탈';
            else if (account === 'isa') statusText = '🛡️ ISA 9.9% 쉴드(합산면제)';
            else if (account === 'pension') statusText = '🛡️ 연금 과세이연(세금0원)';
          } else {
            if (account === 'isa') statusText = '비과세 & 9.9%';
            else if (account === 'pension') statusText = '과세이연 0%';
          }

          milestones.push({
            year: yr,
            principal: totalPrincipal,
            asset: Math.round(totalAsset),
            monthlyDiv: Math.round(currentMonthlyDiv),
            annualDiv: Math.round(currentAnnualDiv),
            taxStatus: statusText,
          });
          chartPoints.push({
            year: yr,
            principal: Math.round(totalPrincipal),
            profit: Math.max(0, Math.round(isDrip ? (totalAsset - totalPrincipal) : (totalAsset - totalPrincipal + totalDivPaid))),
            total: Math.round(totalAsset),
          });
        }
      }

      const finalProfit = Math.round(isDrip ? (totalAsset - totalPrincipal) : (totalAsset - totalPrincipal + totalDivPaid));
      const totalReturnPct = ((finalProfit / (totalPrincipal || 1)) * 100).toFixed(1);

      const lastMilestone = milestones[milestones.length - 1];
      const finalMonthlyDiv = lastMilestone ? lastMilestone.monthlyDiv : 0;
      const finalAnnualDiv = lastMilestone ? lastMilestone.annualDiv : 0;
      const taxSavings = Math.max(0, Math.round(totalGeneralTax - totalActualTaxPaid));

      const resTotalAsset = document.getElementById('res-total-asset');
      const resPrincipalProfit = document.getElementById('res-principal-profit');
      const resMonthlyDiv = document.getElementById('res-monthly-dividend');
      const resAnnualDiv = document.getElementById('res-annual-dividend');
      const resTaxSaved = document.getElementById('res-tax-saved');

      if (resTotalAsset) resTotalAsset.textContent = formatMoney(Math.round(totalAsset), isEn);
      if (resPrincipalProfit) {
        if (isDrip) {
          resPrincipalProfit.innerHTML = isEn
            ? `Principal: <strong>${formatMoney(totalPrincipal, isEn)}</strong> | Net Profit: <span style="color: var(--secondary); font-weight:800;">+${formatMoney(finalProfit, isEn)} (+${totalReturnPct}%)</span>`
            : `총 납입 원금: <strong>${formatMoney(totalPrincipal, isEn)}</strong> | 순수익: <span style="color: var(--secondary); font-weight:800;">+${formatMoney(finalProfit, isEn)} (+${totalReturnPct}%)</span>`;
        } else {
          resPrincipalProfit.innerHTML = isEn
            ? `Principal: <strong>${formatMoney(totalPrincipal, isEn)}</strong> | Cash Dividends: <strong>${formatMoney(Math.round(totalDivPaid), isEn)}</strong> | Total Profit: <span style="color: var(--secondary); font-weight:800;">+${formatMoney(finalProfit, isEn)} (+${totalReturnPct}%)</span>`
            : `총 원금: <strong>${formatMoney(totalPrincipal, isEn)}</strong> | 누적 수령 배당금: <strong>${formatMoney(Math.round(totalDivPaid), isEn)}</strong> | 총순수익: <span style="color: var(--secondary); font-weight:800;">+${formatMoney(finalProfit, isEn)} (+${totalReturnPct}%)</span>`;
        }
      }
      if (resMonthlyDiv) resMonthlyDiv.textContent = `${formatMoney(finalMonthlyDiv, isEn)}${isEn ? ' / mo' : ' / 월'}`;
      if (resAnnualDiv) resAnnualDiv.textContent = isEn ? `Annual Dividend: ${formatMoney(finalAnnualDiv, isEn)}/yr` : `연간 총 배당금: ${formatMoney(finalAnnualDiv, isEn)}`;
      if (resTaxSaved) resTaxSaved.textContent = `+${formatMoney(taxSavings, isEn)}`;

      // Update 20M Tax Shield Banner
      const shieldCard = document.getElementById('tax-shield-card');
      const tsIcon = document.getElementById('ts-icon');
      const tsTitle = document.getElementById('ts-title');
      const tsDesc = document.getElementById('ts-desc');

      if (shieldCard && tsIcon && tsTitle && tsDesc) {
        if (finalAnnualDiv > COMPREHENSIVE_TAX_THRESHOLD) {
          if (account === 'general') {
            shieldCard.className = 'tax-shield-card danger-card';
            tsIcon.textContent = '🚨';
            tsTitle.textContent = isEn ? '20M KRW Tax Bomb Alert: Comprehensive Income Tax Triggered!' : '금융소득 2,000만 원 돌파: 금융소득종합과세 폭탄 및 건보료 박탈!';
            tsDesc.textContent = isEn
              ? `Annual dividend exceeds ₩20M. Excess taxed at ${(marginalTaxRate * 100).toFixed(1)}% and health insurance dependent status revoked.`
              : `연간 배당금이 2,000만 원을 초과하여 초과분에 ${(marginalTaxRate * 100).toFixed(1)}% 종합소득세율이 적용되며, 건강보험료 피부양자 자격이 박탈되어 지역건보료가 부과됩니다.`;
          } else if (account === 'isa') {
            shieldCard.className = 'tax-shield-card success-card';
            tsIcon.textContent = '🛡️';
            tsTitle.textContent = isEn ? 'ISA Tax Shield Active: 100% Comprehensive Tax Immunity!' : 'ISA 절세 쉴드 작동: 금융소득종합과세 100% 면제 & 건보료 피부양자 방어!';
            tsDesc.textContent = isEn
              ? `Annual dividend exceeds ₩20M, but ISA legally separates all income at 9.9% without any comprehensive taxation or health insurance impact!`
              : `연 배당금이 2,000만 원을 초과하지만 조세특례제한법에 따라 전액 종합소득세 합산에서 제외되고 9.9% 분리과세로 종결되며 건보료 피부양자가 안전하게 유지됩니다!`;
          } else if (account === 'pension') {
            shieldCard.className = 'tax-shield-card success-card';
            tsIcon.textContent = '🛡️';
            tsTitle.textContent = isEn ? 'Pension Deferred Shield Active: 0% Tax During Accumulation!' : '연금저축/IRP 과세이연 쉴드: 운용 기간 세금 0원 & 종합과세 원천 차단!';
            tsDesc.textContent = isEn
              ? `Zero taxes paid during accumulation. Complete immunity from comprehensive financial taxation.`
              : `운용 기간 동안 배당소득세가 0원이며 금융소득종합과세가 원천 차단되어 복리 효과가 100% 보존됩니다.`;
          }
        } else {
          shieldCard.className = 'tax-shield-card safe-card';
          tsIcon.textContent = '🟢';
          tsTitle.textContent = isEn ? 'Safe Zone: Annual Dividends Under ₩20 Million' : '금융소득 2,000만 원 이하 안전 구간';
          tsDesc.textContent = isEn
            ? 'Dividends cleanly taxed under 15.4% withholding without comprehensive tax or health insurance risk.'
            : '연간 배당금이 2,000만 원 이하로 15.4% 분리과세로 종결되며 종합과세 및 건보료 피부양자 위험이 없습니다.';
        }
      }

      renderGrowthChart(chartPoints, isEn);
      renderMilestoneTable(milestones, isEn);
    }

    function renderGrowthChart(points: Array<{ year: number; principal: number; profit: number; total: number }>, isEn: boolean) {
      const chartWrap = document.getElementById('chart-bars-wrap');
      if (!chartWrap) return;
      const maxVal = Math.max(...points.map(p => p.total), 1);
      chartWrap.innerHTML = points.map(p => {
        const principalPct = ((p.principal / maxVal) * 100).toFixed(1);
        const profitPct = ((p.profit / maxVal) * 100).toFixed(1);
        return `
          <div class="chart-col">
            <div class="bar-stack" title="${isEn ? 'Year' : ''} ${p.year}${isEn ? '' : '년차'}: ${formatMoney(p.total, isEn)}">
              <div class="bar-seg bar-profit" style="height: ${profitPct}%;"></div>
              <div class="bar-seg bar-principal" style="height: ${principalPct}%;"></div>
            </div>
            <span class="bar-label">${p.year}${isEn ? 'Y' : '년'}</span>
          </div>
        `;
      }).join('');
    }

    function renderMilestoneTable(milestones: Array<{ year: number; principal: number; asset: number; monthlyDiv: number; annualDiv: number; taxStatus: string }>, isEn: boolean) {
      const tbody = document.getElementById('milestone-table-body');
      if (!tbody) return;
      const keyYears = [1, 2, 3, 5, 7, 10, 15, 20, 25, 30];
      const filtered = milestones.filter(m => keyYears.includes(m.year) || m === milestones[milestones.length - 1]);
      tbody.innerHTML = filtered.map(m => `
        <tr>
          <td><strong>${m.year}${isEn ? ' Years' : '년차'}</strong></td>
          <td>${formatMoney(m.principal, isEn)}</td>
          <td style="color: var(--primary); font-weight: 800;">${formatMoney(m.asset, isEn)}</td>
          <td style="color: var(--secondary); font-weight: 700;">${formatMoney(m.monthlyDiv, isEn)}${isEn ? '/mo' : ' / 월'}</td>
          <td style="font-weight: 700;">${formatMoney(m.annualDiv, isEn)}</td>
          <td style="font-size: 0.725rem; font-weight: 700;">${m.taxStatus}</td>
        </tr>
      `).join('');
    }

    // -------------------------------------------------------------
    // 2. HISTORICAL TIME MACHINE BACKTEST LOGIC
    // -------------------------------------------------------------
    const histYearsRange = document.getElementById('hist-years-range') as HTMLInputElement;
    const histYearsDisplay = document.getElementById('hist-years-display');
    const histInitialRange = document.getElementById('hist-initial-range') as HTMLInputElement;
    const histInitialDisplay = document.getElementById('hist-initial-display');
    const histMonthlyRange = document.getElementById('hist-monthly-range') as HTMLInputElement;
    const histMonthlyDisplay = document.getElementById('hist-monthly-display');
    const histAssetSelect = document.getElementById('hist-asset-select') as HTMLSelectElement;
    const histAccountSelect = document.getElementById('hist-account-select') as HTMLSelectElement;

    const histDripOnBtn = document.getElementById('hist-drip-on-btn');
    const histDripOffBtn = document.getElementById('hist-drip-off-btn');
    let isHistDrip = true;

    // Quick Horizon Buttons
    const histQuickBtns = document.querySelectorAll('.hist-quick-btn');
    histQuickBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        histQuickBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const yrs = btn.getAttribute('data-years');
        if (yrs && histYearsRange) {
          histYearsRange.value = yrs;
          calculateHistoricalBacktest();
        }
      });
    });

    histDripOnBtn?.addEventListener('click', () => {
      isHistDrip = true;
      histDripOnBtn.classList.add('active');
      histDripOffBtn?.classList.remove('active');
      calculateHistoricalBacktest();
    });

    histDripOffBtn?.addEventListener('click', () => {
      isHistDrip = false;
      histDripOffBtn.classList.add('active');
      histDripOnBtn?.classList.remove('active');
      calculateHistoricalBacktest();
    });

    [histYearsRange, histInitialRange, histMonthlyRange, histAssetSelect, histAccountSelect].forEach(el => {
      el?.addEventListener('input', calculateHistoricalBacktest);
    });

    function calculateHistoricalBacktest() {
      const yearsBack = parseInt(histYearsRange?.value || '10', 10);
      const initialWon = parseInt(histInitialRange?.value || '2000', 10) * 10000;
      const monthlyWon = parseInt(histMonthlyRange?.value || '100', 10) * 10000;
      const assetKey = histAssetSelect?.value || 'spy';
      const isTaxFree = histAccountSelect?.value === 'isa';

      const currentYear = 2026;
      const startYear = currentYear - yearsBack;

      if (histYearsDisplay) {
        histYearsDisplay.textContent = isEn
          ? `${yearsBack} Years Ago (Started ${startYear})`
          : `${yearsBack}년 전 (${startYear}년 시작)`;
      }
      if (histInitialDisplay) histInitialDisplay.textContent = formatMoney(initialWon, isEn);
      if (histMonthlyDisplay) histMonthlyDisplay.textContent = `${formatMoney(monthlyWon, isEn)}${isEn ? '/mo' : ' / 월'}`;

      const startIndex = Math.max(0, startYear - 1996);

      function getAssetReturns(key: string, idx: number) {
        if (key === 'cc_jepq_daily') {
          return {
            ret: (HIST_DATA.assets.jepq.returns[idx] * 0.5) + (HIST_DATA.assets.jepi.returns[idx] * 0.5),
            div: (HIST_DATA.assets.jepq.divYields[idx] * 0.5) + (HIST_DATA.assets.jepi.divYields[idx] * 0.5)
          };
        } else if (key === 'spy_qqq') {
          return {
            ret: (HIST_DATA.assets.spy.returns[idx] * 0.5) + (HIST_DATA.assets.qqq.returns[idx] * 0.5),
            div: (HIST_DATA.assets.spy.divYields[idx] * 0.5) + (HIST_DATA.assets.qqq.divYields[idx] * 0.5)
          };
        } else if (key === 'schd_spy') {
          return {
            ret: (HIST_DATA.assets.schd.returns[idx] * 0.7) + (HIST_DATA.assets.spy.returns[idx] * 0.3),
            div: (HIST_DATA.assets.schd.divYields[idx] * 0.7) + (HIST_DATA.assets.spy.divYields[idx] * 0.3)
          };
        }
        const a = (HIST_DATA.assets as any)[key] || HIST_DATA.assets.spy;
        return {
          ret: a.returns[idx] || 0.10,
          div: a.divYields[idx] || 0.02
        };
      }

      let currentBalance = initialWon;
      let totalPrincipal = initialWon;
      let cumulativeGrossDiv = 0;
      let cumulativeTaxPaid = 0;
      let peakBalance = initialWon;
      let maxDrawdown = 0;

      const yearlyLogs: Array<{
        year: number;
        startBal: number;
        ret: number;
        grossDiv: number;
        tax: number;
        taxNotice: string;
        netDiv: number;
        endBal: number;
      }> = [];

      for (let i = startIndex; i < HIST_DATA.years.length; i++) {
        const yr = HIST_DATA.years[i];
        const { ret, div } = getAssetReturns(assetKey, i);
        const startOfYrBal = currentBalance;

        const annualDca = monthlyWon * 12;
        currentBalance += annualDca;
        totalPrincipal += annualDca;

        currentBalance = currentBalance * (1 + ret);

        const grossDiv = currentBalance * div;
        let tax = 0;
        let taxNotice = '안전 (15.4%)';

        if (isTaxFree) {
          tax = 0;
          taxNotice = grossDiv > 20000000 ? '🛡️ ISA 쉴드(합산면제)' : '비과세 0원';
        } else {
          if (grossDiv > 20000000) {
            // General Account Comprehensive Taxation
            const excess = grossDiv - 20000000;
            tax = (20000000 * 0.154) + (excess * 0.264);
            taxNotice = '🚨 2천만 초과(종합과세)';
          } else {
            tax = grossDiv * 0.154;
            taxNotice = '일반 15.4%';
          }
        }

        const netDiv = grossDiv - tax;

        cumulativeGrossDiv += grossDiv;
        cumulativeTaxPaid += tax;

        if (isHistDrip) {
          currentBalance += netDiv;
        }

        if (currentBalance > peakBalance) {
          peakBalance = currentBalance;
        } else {
          const dd = (peakBalance - currentBalance) / peakBalance;
          if (dd > maxDrawdown) maxDrawdown = dd;
        }

        yearlyLogs.push({
          year: yr,
          startBal: Math.round(startOfYrBal),
          ret: ret,
          grossDiv: Math.round(grossDiv),
          tax: Math.round(tax),
          taxNotice: taxNotice,
          netDiv: Math.round(netDiv),
          endBal: Math.round(currentBalance)
        });
      }

      const finalProfit = isHistDrip
        ? (currentBalance - totalPrincipal)
        : (currentBalance - totalPrincipal + (cumulativeGrossDiv - cumulativeTaxPaid));
      const totalReturnPct = ((finalProfit / (totalPrincipal || 1)) * 100).toFixed(1);
      const cagr = ((Math.pow(currentBalance / (totalPrincipal || 1), 1 / yearsBack) - 1) * 100).toFixed(2);
      const lastYr = yearlyLogs[yearlyLogs.length - 1];
      const lastYrDiv = lastYr ? lastYr.netDiv : 0;

      const resTotal = document.getElementById('hist-res-total');
      const resSub = document.getElementById('hist-res-sub');
      const resDiv = document.getElementById('hist-res-div');
      const resLastDiv = document.getElementById('hist-res-last-div');
      const resTax = document.getElementById('hist-res-tax');
      const resMdd = document.getElementById('hist-res-mdd');

      if (resTotal) resTotal.textContent = formatMoney(Math.round(currentBalance), isEn);
      if (resSub) {
        resSub.innerHTML = isEn
          ? `Principal: <strong>${formatMoney(totalPrincipal, isEn)}</strong> | Net Profit: <span style="color: var(--secondary); font-weight:800;">+${formatMoney(Math.round(finalProfit), isEn)} (+${totalReturnPct}%)</span> | CAGR: <strong>+${cagr}%</strong>`
          : `총 투자 원금: <strong>${formatMoney(totalPrincipal, isEn)}</strong> | 실현 수익: <span style="color: var(--secondary); font-weight:800;">+${formatMoney(Math.round(finalProfit), isEn)} (+${totalReturnPct}%)</span> | 연평균 CAGR: <strong>+${cagr}%</strong>`;
      }
      if (resDiv) resDiv.textContent = formatMoney(Math.round(cumulativeGrossDiv), isEn);
      if (resLastDiv) resLastDiv.textContent = isEn ? `Recent Year Net Div: ${formatMoney(lastYrDiv, isEn)}` : `최근 연간 실수령 배당: ${formatMoney(lastYrDiv, isEn)}`;
      if (resTax) {
        resTax.textContent = isTaxFree
          ? (isEn ? '₩0 (ISA Tax Shielded)' : '0원 (ISA 절세 쉴드)')
          : formatMoney(Math.round(cumulativeTaxPaid), isEn);
      }
      if (resMdd) {
        resMdd.textContent = isEn
          ? `Max Drawdown (MDD): -${(maxDrawdown * 100).toFixed(1)}%`
          : `역사적 최대 낙폭 (MDD): -${(maxDrawdown * 100).toFixed(1)}%`;
      }

      const tableBody = document.getElementById('hist-table-body');
      if (tableBody) {
        tableBody.innerHTML = yearlyLogs.map(log => {
          const retClass = log.ret >= 0 ? 'text-pos' : 'text-neg';
          const retSign = log.ret >= 0 ? '+' : '';
          return `
            <tr>
              <td><strong>${log.year}년</strong></td>
              <td>${formatMoney(log.startBal, isEn)}</td>
              <td class="${retClass}" style="font-weight: 700;">${retSign}${(log.ret * 100).toFixed(1)}%</td>
              <td style="color: var(--primary); font-weight: 700;">${formatMoney(log.grossDiv, isEn)}</td>
              <td style="color: var(--danger);">${formatMoney(log.tax, isEn)}</td>
              <td style="font-size: 0.725rem; font-weight: 700;">${log.taxNotice}</td>
              <td style="color: var(--secondary); font-weight: 800;">${formatMoney(log.endBal, isEn)}</td>
            </tr>
          `;
        }).join('');
      }
    }

    function formatMoney(num: number, isEn: boolean): string {
      if (isEn) {
        if (num >= 100000000) return `₩${(num / 100000000).toFixed(2)}B`;
        if (num >= 10000) return `₩${Math.round(num / 10000).toLocaleString()}0k`;
        return `₩${num.toLocaleString('en-US')}`;
      }
      if (num >= 100000000) {
        const eok = Math.floor(num / 100000000);
        const man = Math.round((num % 100000000) / 10000);
        return man > 0 ? `${eok}억 ${man.toLocaleString('ko-KR')}만 원` : `${eok}억 원`;
      }
      if (num >= 10000) {
        return `${Math.round(num / 10000).toLocaleString('ko-KR')}만 원`;
      }
      return `${num.toLocaleString('ko-KR')}원`;
    }

    // Run calculations
    calculateForwardSimulation();
    calculateHistoricalBacktest();
  }

  initApp();
  document.addEventListener('astro:after-swap', initApp);
</script>

