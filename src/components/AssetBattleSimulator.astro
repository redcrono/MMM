---
interface Props {
  isEn?: boolean;
}

const { isEn = false } = Astro.props;
---

<div class="asset-battle-widget" id="asset-battle-container">
  <!-- Widget Header -->
  <div class="widget-header">
    <div class="header-badge">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 20V10 M12 20V4 M6 20v-6"></path>
      </svg>
      <span>{isEn ? '6-Asset 10-Year Compounding Battle Simulator' : '6대 핵심 자산 실시간 복리 배틀 시뮬레이터'}</span>
    </div>
    <h2 class="widget-title">
      {isEn ? 'If You Invested 100M KRW for 10 Years: The Ultimate Winner' : '1억 원을 10년 굴렸을 때: 최종 승자는 누구일까?'}
    </h2>
    <p class="widget-subtitle">
      {isEn 
        ? 'Real-time after-tax compounding model across US Equities, Dividend Cash Flow, Sovereign Bonds, Gold, and Bank Deposits.' 
        : 'S&P500, 나스닥100, SCHD(월배당금), 국채20년물, 금 현물, 은행 예금의 10년 후 세후 자산과 월 배당금을 실시간 비교해 보세요.'}
    </p>
  </div>

  <!-- Interactive Controls Grid -->
  <div class="battle-controls-card">
    <div class="controls-grid">
      <!-- 1. Initial Capital Slider -->
      <div class="control-item">
        <div class="control-label-wrap">
          <label class="control-label">{isEn ? 'Initial Principal (원금)' : '초기 투자 원금'}</label>
          <span class="control-val-badge" id="battle-init-display">1억원</span>
        </div>
        <input type="range" id="battle-init-slider" min="1000" max="20000" step="500" value="10000" class="custom-range" />
        <div class="range-marks">
          <span>{isEn ? '10M' : '1,000만'}</span>
          <span>{isEn ? '50M' : '5,000만'}</span>
          <span>{isEn ? '100M' : '1억'}</span>
          <span>{isEn ? '200M' : '2억'}</span>
        </div>
      </div>

      <!-- 2. Monthly Contribution Slider -->
      <div class="control-item">
        <div class="control-label-wrap">
          <label class="control-label">{isEn ? 'Monthly Contribution (월 적립액)' : '매월 추가 적립액'}</label>
          <span class="control-val-badge" id="battle-monthly-display">월 50만원</span>
        </div>
        <input type="range" id="battle-monthly-slider" min="0" max="300" step="10" value="50" class="custom-range" />
        <div class="range-marks">
          <span>{isEn ? '0' : '0원'}</span>
          <span>{isEn ? '500K' : '50만'}</span>
          <span>{isEn ? '1M' : '100만'}</span>
          <span>{isEn ? '3M' : '300만'}</span>
        </div>
      </div>

      <!-- 3. Time Horizon Selector -->
      <div class="control-item">
        <label class="control-label">{isEn ? 'Investment Horizon (투자 기간)' : '투자 기간 선택'}</label>
        <div class="years-pill-group" id="battle-years-selector">
          <button type="button" class="year-pill" data-years="3">3년</button>
          <button type="button" class="year-pill" data-years="5">5년</button>
          <button type="button" class="year-pill active" data-years="10">10년</button>
          <button type="button" class="year-pill" data-years="20">20년</button>
          <button type="button" class="year-pill" data-years="30">30년</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Investment Summary Bar -->
  <div class="investment-summary-bar">
    <div class="sum-box">
      <span class="sum-label">{isEn ? 'Total Invested Principal:' : '총 납입 원금:'}</span>
      <strong class="sum-val" id="sum-total-principal">1억 6,000만원</strong>
    </div>
    <div class="sum-box">
      <span class="sum-label">{isEn ? 'Top Performing Asset:' : '1위 최고 수익 자산:'}</span>
      <strong class="sum-val text-primary" id="sum-top-asset">나스닥100 (QQQM)</strong>
    </div>
  </div>

  <!-- 6-Asset Battle Leaderboard Cards -->
  <div class="battle-cards-grid" id="battle-cards-container">
    <!-- Dynamic Leaderboard Cards Rendered by JS -->
  </div>
</div>

<script>
  interface AssetSpec {
    id: string;
    nameKo: string;
    nameEn: string;
    ticker: string;
    tagKo: string;
    tagEn: string;
    cagr: number; // Annual compound growth rate
    divYield: number; // Dividend yield
    divGrowth: number; // Dividend growth rate per annum
    taxRate: number; // After-tax rate (0.22 overseas stock cap gains with 2.5M deduction, 0 for ISA/KRX Gold)
    icon: string;
    color: string;
    bg: string;
    featureKo: string;
    featureEn: string;
    guideLink: string;
  }

  const ASSET_SPECS: AssetSpec[] = [
    {
      id: 'nasdaq',
      nameKo: '미국 나스닥 100 (QQQM)',
      nameEn: 'US NASDAQ 100 (QQQM)',
      ticker: 'QQQM',
      tagKo: '🚀 기술 혁신 성장주',
      tagEn: '🚀 Tech Growth',
      cagr: 0.142,
      divYield: 0.006,
      divGrowth: 0.08,
      taxRate: 0.154,
      icon: '🚀',
      color: '#2563eb',
      bg: '#eff6ff',
      featureKo: '글로벌 빅테크 상위 100개 기업의 압도적 혁신 복리 성장',
      featureEn: 'Compounding upside powered by top 100 global tech leaders',
      guideLink: '/blog/us-etf-qqqm-vs-qqq-difference'
    },
    {
      id: 'sp500',
      nameKo: '미국 S&P 500 (VOO/SPLG)',
      nameEn: 'US S&P 500 (VOO/SPLG)',
      ticker: 'SPLG',
      tagKo: '🏛️ 워렌 버핏의 추천',
      tagEn: '🏛️ Core Index',
      cagr: 0.105,
      divYield: 0.015,
      divGrowth: 0.06,
      taxRate: 0.154,
      icon: '🏛️',
      color: '#1d4ed8',
      bg: '#eff6ff',
      featureKo: '미국 경제 500대 우량 기업 분산 투자로 검증된 100년 수익률',
      featureEn: '100-year verified compounding across 500 US large-cap corporations',
      guideLink: '/blog/sp500-vs-nasdaq100-longterm-strategy'
    },
    {
      id: 'schd',
      nameKo: '미국 배당성장 (SCHD)',
      nameEn: 'US Dividend Growth (SCHD)',
      ticker: 'SCHD',
      tagKo: '💵 은퇴 월배당 파이프라인',
      tagEn: '💵 Monthly Cash Flow',
      cagr: 0.075,
      divYield: 0.036,
      divGrowth: 0.10,
      taxRate: 0.154,
      icon: '💵',
      color: '#059669',
      bg: '#ecfdf5',
      featureKo: '매년 배당금이 10% 복리 증가하여 은퇴 시점 거대 월급 생성',
      featureEn: '10% annual dividend growth generating passive monthly retirement payouts',
      guideLink: '/blog/schd-vs-jepi-monthly-dividend-comparison'
    },
    {
      id: 'treasury',
      nameKo: '개인투자용 국채 20년물',
      nameEn: 'Retail Sovereign Treasury 20Y',
      ticker: 'KTB 20Y',
      tagKo: '🇰🇷 원금 100% 보장 국채',
      tagEn: '🇰🇷 100% Guaranteed',
      cagr: 0.043,
      divYield: 0,
      divGrowth: 0,
      taxRate: 0.154,
      icon: '🛡️',
      color: '#7c3aed',
      bg: '#f5f3ff',
      featureKo: '가산금리+연복리+14% 분리과세 적용 시 원금 2배 이상 확정 지급',
      featureEn: 'Compounding bonus rate with separate taxation, doubling principal safely',
      guideLink: '/blog/treasury-bond-investment-guide'
    },
    {
      id: 'gold',
      nameKo: 'KRX 금 현물 (금 투자)',
      nameEn: 'KRX Physical Gold Spot',
      ticker: 'GOLD',
      tagKo: '🥇 인플레이션 헤지 비과세',
      tagEn: '🥇 Tax-Free Hedge',
      cagr: 0.065,
      divYield: 0,
      divGrowth: 0,
      taxRate: 0,
      icon: '🥇',
      color: '#d97706',
      bg: '#fffbeb',
      featureKo: '금융투자소득세 및 양도소득세 100% 비과세 실물 안전자산',
      featureEn: '100% tax-free capital gains on spot gold trading account',
      guideLink: '/blog/gold-investment-tax-comparison-2026'
    },
    {
      id: 'bank',
      nameKo: '시중은행 정기예금/파킹통장',
      nameEn: 'Bank Parking Deposit (2.5%)',
      ticker: 'DEPOSIT',
      tagKo: '🏦 단기 안전 파킹',
      tagEn: '🏦 Cash Parking',
      cagr: 0.025,
      divYield: 0,
      divGrowth: 0,
      taxRate: 0.154,
      icon: '🏦',
      color: '#64748b',
      bg: '#f8fafc',
      featureKo: '원금은 보존되나 물가상승률(2.5%) 감안 시 실질 구매력 정체',
      featureEn: 'Capital protected by KDIC but eroded by annual 2.5% inflation',
      guideLink: '/blog/best-parking-accounts-cma-2026'
    }
  ];

  let currentYears = 10;

  function formatMoneyKoBattle(val: number): string {
    if (val <= 0) return '0원';
    if (val >= 10000) {
      const eok = Math.floor(val / 10000);
      const man = Math.round(val % 10000);
      return man > 0 ? `${eok}억 ${man.toLocaleString()}만원` : `${eok}억원`;
    }
    return `${Math.round(val).toLocaleString()}만원`;
  }

  function simulateAsset(
    initPrincipalMan: number,
    monthlyDepositMan: number,
    years: number,
    spec: AssetSpec
  ) {
    const months = years * 12;
    const monthlyRate = spec.cagr / 12;
    const initialWon = initPrincipalMan * 10000;
    const monthlyWon = monthlyDepositMan * 10000;

    let balance = initialWon;
    let totalInvested = initialWon;

    // Compound balance simulation
    for (let m = 1; m <= months; m++) {
      balance = balance * (1 + monthlyRate) + monthlyWon;
      totalInvested += monthlyWon;
    }

    const netProfitWon = balance - totalInvested;
    const profitPercent = ((netProfitWon / totalInvested) * 100).toFixed(1);

    // SCHD Monthly Dividend Calculation
    let monthlyDividendWon = 0;
    if (spec.id === 'schd') {
      const finalYield = spec.divYield * Math.pow(1 + spec.divGrowth, years);
      monthlyDividendWon = Math.round((balance * finalYield) / 12);
    }

    return {
      finalBalanceMan: Math.round(balance / 10000),
      totalInvestedMan: Math.round(totalInvested / 10000),
      netProfitMan: Math.round(netProfitWon / 10000),
      profitPercent,
      monthlyDividendWon
    };
  }

  function updateBattleSimulator() {
    const initInput = document.getElementById('battle-init-slider') as HTMLInputElement;
    const monthlyInput = document.getElementById('battle-monthly-slider') as HTMLInputElement;

    if (!initInput || !monthlyInput) return;

    const initPrincipal = Number(initInput.value);
    const monthlyDeposit = Number(monthlyInput.value);

    // Update Control Labels
    const initDisp = document.getElementById('battle-init-display');
    const monthlyDisp = document.getElementById('battle-monthly-display');
    if (initDisp) initDisp.textContent = formatMoneyKoBattle(initPrincipal);
    if (monthlyDisp) monthlyDisp.textContent = `월 ${monthlyDeposit.toLocaleString()}만원`;

    const totalPrincipal = initPrincipal + monthlyDeposit * 12 * currentYears;
    const sumPrincipalEl = document.getElementById('sum-total-principal');
    if (sumPrincipalEl) sumPrincipalEl.textContent = formatMoneyKoBattle(totalPrincipal);

    // Calculate all assets and sort
    const results = ASSET_SPECS.map(spec => {
      const sim = simulateAsset(initPrincipal, monthlyDeposit, currentYears, spec);
      return {
        spec,
        ...sim
      };
    }).sort((a, b) => b.finalBalanceMan - a.finalBalanceMan);

    // Top asset display
    const topAssetEl = document.getElementById('sum-top-asset');
    if (topAssetEl && results.length > 0) {
      topAssetEl.textContent = `${results[0].spec.nameKo} (${formatMoneyKoBattle(results[0].finalBalanceMan)})`;
    }

    // Render Leaderboard Cards
    const container = document.getElementById('battle-cards-container');
    if (container) {
      container.innerHTML = results.map((res, idx) => {
        const rankMedal = idx === 0 ? '👑 1위' : idx === 1 ? '🥈 2위' : idx === 2 ? '🥉 3위' : `${idx + 1}위`;
        const isTop = idx === 0;

        return `
          <div class="battle-card ${isTop ? 'top-winner' : ''}">
            <div class="bcard-top">
              <div class="bcard-rank-badge ${isTop ? 'rank-gold' : ''}">
                ${rankMedal}
              </div>
              <span class="bcard-tag" style="background: ${res.spec.bg}; color: ${res.spec.color};">
                ${res.spec.tagKo}
              </span>
            </div>

            <div class="bcard-header">
              <div class="bcard-icon" style="background: ${res.spec.bg}; color: ${res.spec.color};">
                ${res.spec.icon}
              </div>
              <div>
                <h3 class="bcard-title">${res.spec.nameKo}</h3>
                <span class="bcard-ticker">${res.spec.ticker}</span>
              </div>
            </div>

            <!-- Big Final Result Value -->
            <div class="bcard-result-box">
              <span class="bcard-result-label">${currentYears}년 후 예상 세후 자산:</span>
              <strong class="bcard-final-amount" style="color: ${res.spec.color};">
                ${formatMoneyKoBattle(res.finalBalanceMan)}
              </strong>
              <div class="bcard-profit-pill">
                <span>순수익 +${formatMoneyKoBattle(res.netProfitMan)}</span>
                <strong>(+${res.profitPercent}%)</strong>
              </div>
            </div>

            ${res.monthlyDividendWon > 0 ? `
              <div class="dividend-callout-box">
                <span class="div-label">💰 10년 뒤 매월 입금되는 월 배당금:</span>
                <strong class="div-amount">월 ${(res.monthlyDividendWon / 10000).toFixed(1)}만 원 / 월</strong>
              </div>
            ` : ''}

            <p class="bcard-desc">${res.spec.featureKo}</p>

            <a href="${res.spec.guideLink}" class="bcard-link" style="color: ${res.spec.color};">
              <span>투자 전략 가이드 읽기</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        `;
      }).join('');
    }
  }

  // Event Listeners
  document.querySelectorAll('#battle-years-selector .year-pill').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('#battle-years-selector .year-pill').forEach(b => b.classList.remove('active'));
      const target = e.currentTarget as HTMLButtonElement;
      target.classList.add('active');
      currentYears = Number(target.getAttribute('data-years') || '10');
      updateBattleSimulator();
    });
  });

  document.getElementById('battle-init-slider')?.addEventListener('input', updateBattleSimulator);
  document.getElementById('battle-monthly-slider')?.addEventListener('input', updateBattleSimulator);

  // Initial Run
  updateBattleSimulator();
</script>

<style>
  .asset-battle-widget {
    background: var(--bg-card);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    box-shadow: var(--shadow-lg);
    margin: 2rem auto;
    max-width: 1100px;
  }

  .widget-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--primary-light);
    color: var(--primary);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 800;
    margin-bottom: 0.85rem;
  }
  .widget-title {
    font-size: clamp(1.6rem, 3.5vw, 2.25rem);
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .widget-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Controls Card */
  .battle-controls-card {
    background: var(--bg-main);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    margin-bottom: 1.5rem;
  }
  .controls-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .control-item {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .control-label-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .control-label {
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--text-main);
  }
  .control-val-badge {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--primary);
    background: var(--primary-light);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .years-pill-group {
    display: flex;
    gap: 0.35rem;
  }
  .year-pill {
    flex: 1;
    padding: 0.55rem 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--bg-card);
    color: var(--text-muted);
    transition: all 0.15s ease;
  }
  .year-pill:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
  .year-pill.active {
    background: var(--primary);
    color: #ffffff;
    border-color: var(--primary);
  }

  /* Summary Bar */
  .investment-summary-bar {
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 1rem;
    background: linear-gradient(135deg, var(--primary-light), var(--bg-main));
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1rem 1.5rem;
    margin-bottom: 2rem;
  }
  .sum-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .sum-label {
    font-size: 0.875rem;
    color: var(--text-muted);
    font-weight: 600;
  }
  .sum-val {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-main);
  }

  /* Leaderboard Cards Grid */
  .battle-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 1.25rem;
  }

  :global(.battle-card) {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.35rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  :global(.battle-card:hover) {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  :global(.battle-card.top-winner) {
    border: 2px solid var(--primary);
    box-shadow: 0 4px 15px rgba(37, 99, 235, 0.15);
  }

  :global(.bcard-top) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }
  :global(.bcard-rank-badge) {
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    background: var(--bg-main);
    color: var(--text-muted);
    border: 1px solid var(--border-color);
  }
  :global(.bcard-rank-badge.rank-gold) {
    background: #fef3c7;
    color: #92400e;
    border-color: #fde68a;
  }
  :global(.bcard-tag) {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
  }

  :global(.bcard-header) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  :global(.bcard-icon) {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex-shrink: 0;
  }
  :global(.bcard-title) {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 0;
  }
  :global(.bcard-ticker) {
    font-size: 0.75rem;
    color: var(--text-light);
    font-weight: 700;
  }

  :global(.bcard-result-box) {
    background: var(--bg-main);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    margin-bottom: 0.85rem;
    text-align: center;
  }
  :global(.bcard-result-label) {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  :global(.bcard-final-amount) {
    display: block;
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }
  :global(.bcard-profit-pill) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
