---
// Interactive Tax Savings Widget for Information Gain
interface Props {
  lang?: 'ko' | 'en';
}

const { lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'ko' } = Astro.props;
const isEn = lang === 'en';
---

<div class="calculator-widget">
  <div class="calc-header">
    <div class="calc-icon" style="color: var(--primary); display: flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; background: var(--primary-light); border-radius: var(--radius-md); flex-shrink: 0;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="2" width="16" height="20" rx="2"></rect>
        <line x1="8" y1="6" x2="16" y2="6"></line>
        <line x1="16" y1="14" x2="16" y2="18"></line>
        <path d="M16 10h.01"></path>
        <path d="M12 10h.01"></path>
        <path d="M8 10h.01"></path>
        <path d="M12 14h.01"></path>
        <path d="M8 14h.01"></path>
        <path d="M12 18h.01"></path>
        <path d="M8 18h.01"></path>
      </svg>
    </div>
    <div>
      <h3 class="calc-title">
        {isEn ? "2026 Korea Pension (IRP / Pension Savings) Tax Refund Calculator" : "2026 연금계좌(IRP/연금저축) 세액공제 예상 환급액 계산기"}
      </h3>
      <p class="calc-subtitle">
        {isEn ? "Simulate your estimated February year-end tax settlement refund based on annual deposits." : "연간 납입액과 총급여에 따른 예상 연말정산 환급금을 즉시 시뮬레이션합니다."}
      </p>
    </div>
  </div>

  <div class="calc-form-grid">
    <div class="calc-field">
      <label for="salary-select" class="calc-label">
        {isEn ? "Gross Annual Salary Bracket" : "총급여(연봉) 구간"}
      </label>
      <select id="salary-select" class="calc-select">
        <option value="0.165">{isEn ? "≤ 55 Million KRW (16.5% Deduction Rate)" : "5,500만 원 이하 (공제율 16.5%)"}</option>
        <option value="0.132">{isEn ? "> 55 Million KRW (13.2% Deduction Rate)" : "5,500만 원 초과 (공제율 13.2%)"}</option>
      </select>
    </div>

    <div class="calc-field">
      <label for="deposit-amount" class="calc-label">
        {isEn ? "Annual Contribution (Max 9M KRW)" : "연간 총 납입액 (최대 900만 원)"}
      </label>
      <select id="deposit-amount" class="calc-select">
        <option value="3000000">{isEn ? "3,000,000 KRW (250K KRW/month)" : "300만 원 (월 25만 원)"}</option>
        <option value="6000000">{isEn ? "6,000,000 KRW (Pension Savings Cap)" : "600만 원 (연금저축 단독 한도)"}</option>
        <option value="9000000" selected>{isEn ? "9,000,000 KRW (Pension Savings + IRP Cap)" : "900만 원 (연금저축+IRP 합산 최대 한도)"}</option>
      </select>
    </div>
  </div>

  <div class="calc-result-box">
    <div class="calc-result-main">
      <span class="calc-result-label">
        {isEn ? "Estimated Year-End Tax Refund (Feb)" : "내년 2월 예상 연말정산 환급금"}
      </span>
      <div id="refund-result" class="calc-result-value">
        {isEn ? "1,485,000 KRW" : "1,485,000 원"}
      </div>
    </div>
    <div class="calc-result-note">
      {isEn ? (
        <>
          * Includes 10% local income tax<br />
          * Actual refund applies within calculated tax liability
        </>
      ) : (
        <>
          * 지방소득세 10% 포함 기준<br />
          * 실제 환급액은 결정세액 한도 내 적용
        </>
      )}
    </div>
  </div>
</div>

<style>
  .calculator-widget {
    margin: 2.5rem 0;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-focus);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  .calc-header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .calc-icon {
    font-size: 1.75rem;
    line-height: 1;
  }
  .calc-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 0 0 0.25rem 0;
    line-height: 1.35;
  }
  .calc-subtitle {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }
  .calc-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .calc-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.4rem;
  }
  .calc-select {
    width: 100%;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--bg-main);
    color: var(--text-main);
    font-family: inherit;
    font-size: 0.9rem;
    transition: border-color var(--transition-fast);
  }
  .calc-select:focus {
    outline: none;
    border-color: var(--primary);
  }
  .calc-result-box {
    background: var(--primary-light);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .calc-result-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
    display: block;
    margin-bottom: 0.25rem;
  }
  .calc-result-value {
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--primary);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .calc-result-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-align: right;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .calculator-widget {
      padding: 1.15rem;
      margin: 1.75rem 0;
    }
    .calc-title {
      font-size: 1.05rem;
    }
    .calc-form-grid {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
    .calc-result-box {
      flex-direction: column;
      align-items: flex-start;
      padding: 1rem;
    }
    .calc-result-value {
      font-size: 1.45rem;
    }
    .calc-result-note {
      text-align: left;
      font-size: 0.75rem;
    }
  }
</style>

<script is:inline define:vars={{ isEn }}>
  const salarySelect = document.getElementById('salary-select');
  const depositSelect = document.getElementById('deposit-amount');
  const refundResult = document.getElementById('refund-result');

  function calculateTaxRefund() {
    const rate = parseFloat(salarySelect.value);
    const deposit = parseInt(depositSelect.value, 10);
    const refund = Math.round(deposit * rate);
    const unit = isEn ? ' KRW' : ' 원';
    refundResult.textContent = refund.toLocaleString(isEn ? 'en-US' : 'ko-KR') + unit;
  }

  salarySelect?.addEventListener('change', calculateTaxRefund);
  depositSelect?.addEventListener('change', calculateTaxRefund);
</script>
