---
import { getCollection } from 'astro:content';

export interface Props {
  title: string;
  description: string;
  image?: string;
  articleDate?: Date;
  updatedDate?: Date;
  articleAuthor?: string;
  category?: string;
  noindex?: boolean;
}

const categoryHeroMap: Record<string, string> = {
  tax: '/images/tax_refund_hero.jpg',
  wealth: '/images/isa_growth_hero.jpg',
  stocks: '/images/covered_call_tax_hero.jpg',
  credit: '/images/stress_dsr_hero.jpg',
  subsidy: '/images/youth_rent_hero.jpg',
  economy: '/images/jackson_hole_hero.jpg',
  expats: '/images/tax_refund_hero.jpg',
};

const {
  title,
  description,
  image,
  articleDate,
  updatedDate,
  articleAuthor,
  category,
  noindex = false,
} = Astro.props;

const resolvedImage = image || (category && categoryHeroMap[category]) || '/images/og-default.png';

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.megamomo.co.kr');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isEn =
  currentPath.startsWith('/en') ||
  currentPath.includes('/en-') ||
  currentPath.includes('/korea-') ||
  currentPath.includes('/open-korea-') ||
  currentPath.includes('/best-korea-') ||
  currentPath.includes('-expats') ||
  currentPath.includes('-foreigners') ||
  currentPath.includes('travel-cards');

const siteTitle = isEn
  ? 'MegaMoneyMomentum (MMM) | South Korea Finance, Tax & Policy Research'
  : '메가머니모멘텀(MegaMoneyMomentum) | 금융·세무·정책 나침반';
const brandSuffix = isEn ? 'MegaMoneyMomentum' : '메가머니모멘텀';
const fullTitle =
  title === siteTitle || title.includes('MegaMoneyMomentum') || title.includes('메가머니모멘텀')
    ? title
    : `${title} | ${brandSuffix}`;

const siteRoot = 'https://www.megamomo.co.kr';
const allBlogSlugs = new Set((await getCollection('blog')).map((p) => p.slug));

let koUrl: string | null = `${siteRoot}${Astro.url.pathname}`;
let enUrl: string | null = `${siteRoot}/en`;

if (currentPath.startsWith('/blog/')) {
  const slug = currentPath.replace('/blog/', '');
  if (isEn) {
    enUrl = `${siteRoot}/blog/${slug}`;
    const candidateKoSlug = slug.startsWith('en-') ? slug.slice(3) : '';
    koUrl = candidateKoSlug && allBlogSlugs.has(candidateKoSlug) ? `${siteRoot}/blog/${candidateKoSlug}` : null;
  } else {
    koUrl = `${siteRoot}/blog/${slug}`;
    const candidateEnSlug = `en-${slug}`;
    enUrl = allBlogSlugs.has(candidateEnSlug) ? `${siteRoot}/blog/${candidateEnSlug}` : null;
  }
} else if (isEn) {
  enUrl = `${siteRoot}${Astro.url.pathname}`;
  if (currentPath === '/en') {
    koUrl = `${siteRoot}/`;
  } else if (currentPath === '/en/category/expats') {
    koUrl = null;
  } else if (currentPath.startsWith('/en/category/')) {
    koUrl = `${siteRoot}${currentPath.replace('/en/category/', '/category/')}`;
  } else if (currentPath.startsWith('/en/')) {
    koUrl = `${siteRoot}${currentPath.replace('/en/', '/')}`;
  } else {
    koUrl = `${siteRoot}/`;
  }
} else {
  koUrl = `${siteRoot}${Astro.url.pathname}`;
  if (currentPath === '/') {
    enUrl = `${siteRoot}/en`;
  } else if (currentPath.startsWith('/category/')) {
    enUrl = `${siteRoot}${currentPath.replace('/category/', '/en/category/')}`;
  } else if (
    currentPath.startsWith('/about') ||
    currentPath.startsWith('/privacy') ||
    currentPath.startsWith('/terms') ||
    currentPath.startsWith('/disclaimer') ||
    currentPath.startsWith('/contact') ||
    currentPath.startsWith('/editorial-guidelines') ||
    currentPath.startsWith('/tools') ||
    currentPath.startsWith('/etf') ||
    currentPath.startsWith('/ladder') ||
    currentPath.startsWith('/battle') ||
    currentPath.startsWith('/calendar') ||
    currentPath.startsWith('/qna')
  ) {
    enUrl = `${siteRoot}/en${currentPath}`;
  } else {
    enUrl = null;
  }
}
const xDefaultUrl = koUrl || enUrl || siteRoot;

// Schema.org Structured Data
const fullImageUrl = new URL(resolvedImage, canonicalURL).toString();
const jsonLd = articleDate
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description: description,
      image: [fullImageUrl],
      author: {
        '@type': 'Organization',
        name: articleAuthor || (isEn ? 'MegaMoneyMomentum Editorial Team' : '메가머니모멘텀 금융데이터 리서치팀'),
        url: isEn ? `${siteRoot}/en/about` : `${siteRoot}/about`,
      },
      publisher: {
        '@type': 'Organization',
        name: isEn ? 'MegaMoneyMomentum (MMM)' : '메가머니모멘텀(MegaMoneyMomentum)',
        url: siteRoot,
        logo: {
          '@type': 'ImageObject',
          url: `${siteRoot}/favicon.svg`,
        },
        publishingPrinciples: isEn ? `${siteRoot}/en/editorial-guidelines` : `${siteRoot}/editorial-guidelines`,
      },
      datePublished: articleDate.toISOString(),
      dateModified: (updatedDate || articleDate).toISOString(),
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL.toString(),
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: isEn ? 'MegaMoneyMomentum (MMM)' : '메가머니모멘텀',
      url: isEn ? `${siteRoot}/en` : siteRoot,
      publishingPrinciples: isEn ? `${siteRoot}/en/editorial-guidelines` : `${siteRoot}/editorial-guidelines`,
      potentialAction: {
        '@type': 'SearchAction',
        target: `${siteRoot}/search?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    };
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalURL} />
<meta name="generator" content={Astro.generator} />

<!-- Multilingual SEO (hreflang - Verified Existing Routes Only) -->
{koUrl && <link rel="alternate" hreflang="ko" href={koUrl} />}
{enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

<!-- Google Search Console Verification -->
<meta name="google-site-verification" content="Tl7XeCiQwyPZHv-fPvAk0iAufVKjxUDzYuBF7bO3Dr4" />

<!-- Naver Search Advisor Verification -->
<meta name="naver-site-verification" content="2d2ee1689ef06405df9890adf7929086216746fc" />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta
  name="robots"
  content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content={articleDate ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:site_name" content={isEn ? "MegaMoneyMomentum" : "메가머니모멘텀"} />
<meta property="og:locale" content={isEn ? "en_US" : "ko_KR"} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={fullImageUrl} />

<!-- RSS Feed -->
<link rel="alternate" type="application/rss+xml" title="메가머니모멘텀 RSS 피드" href="/rss.xml" />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!-- Google AdSense Account Ownership Verification (Meta Tag) -->
<meta name="google-adsense-account" content="ca-pub-1414525586943831" />

<!-- Google AdSense Verification & Auto Ads Script -->
<script
  async
  src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1414525586943831"
  crossorigin="anonymous"
></script>
