---
interface Props {
  isEn?: boolean;
}

const { isEn = false } = Astro.props;
---

<div class="reading-mode-container" id="reading-mode-switcher">
  <div class="mode-switch-bar">
    <div class="mode-label">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
      </svg>
      <span>{isEn ? 'Reading Mode' : '읽기 모드 전환'}</span>
    </div>
    
    <div class="mode-tabs">
      <button
        type="button"
        class="mode-tab-btn active"
        data-mode="pro"
        aria-label={isEn ? "Switch to Pro Analysis Mode" : "전문가 정밀 분석 모드로 전환"}
      >
        <span class="tab-icon">📊</span>
        <span class="tab-text">{isEn ? 'Pro Analysis' : '전문가 정밀 분석'}</span>
      </button>

      <button
        type="button"
        class="mode-tab-btn"
        data-mode="smart"
        aria-label={isEn ? "Switch to Smart Brief 3-Min Mode" : "3분 스마트 요약 모드로 전환"}
      >
        <span class="tab-icon">💡</span>
        <span class="tab-text">{isEn ? '3-Min Smart Brief' : '3분 스마트 요약'}</span>
        <span class="mode-pill-badge">{isEn ? 'FAST' : '추천'}</span>
      </button>
    </div>
  </div>

  <!-- Smart Brief Container (Displayed in Smart Mode) -->
  <div class="smart-brief-wrapper" id="smart-brief-wrapper" style="display: none;">
    <div class="smart-brief-box-inline">
      <div class="sb-inline-header">
        <span class="sb-inline-badge">💡 {isEn ? '3-Minute Smart Brief' : '3분 스마트 요약 모드'}</span>
        <span class="sb-inline-sub">{isEn ? 'Executive digest tailored for fast reading' : '바쁜 직장인·투자자를 위한 30초 핵심 브리핑'}</span>
      </div>
      <div class="sb-inline-body" id="sb-inline-body">
        <!-- Dynamically generated if manual smart brief box is absent -->
      </div>
    </div>
  </div>
</div>

<script>
  function initReadingMode() {
    const savedMode = localStorage.getItem('mmm-reading-mode') || 'pro';
    applyReadingMode(savedMode);

    const buttons = document.querySelectorAll('.mode-tab-btn');
    buttons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const mode = target.getAttribute('data-mode') || 'pro';
        applyReadingMode(mode);
        localStorage.setItem('mmm-reading-mode', mode);
      });
    });
  }

  function applyReadingMode(mode: string) {
    // 1. Update Buttons
    const buttons = document.querySelectorAll('.mode-tab-btn');
    buttons.forEach((btn) => {
      if (btn.getAttribute('data-mode') === mode) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    // 2. Set root attribute for CSS styling
    document.documentElement.setAttribute('data-reading-mode', mode);

    // 3. Handle Smart Brief Transformation
    const smartWrapper = document.getElementById('smart-brief-wrapper');
    const sbBody = document.getElementById('sb-inline-body');
    const existingSmartBox = document.querySelector('.article-content .smart-brief-box') as HTMLElement;
    const articleBody = document.querySelector('.article-content') as HTMLElement;
    const isEn = document.documentElement.lang === 'en' || window.location.pathname.startsWith('/en');

    if (mode === 'smart') {
      if (existingSmartBox) {
        // If article already has dedicated smart brief, highlight and scroll to it
        existingSmartBox.style.display = 'block';
        existingSmartBox.classList.add('pulse-highlight');
        existingSmartBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        if (smartWrapper) smartWrapper.style.display = 'none';
      } else if (articleBody && smartWrapper && sbBody) {
        // Dynamically extract core summary, headings, and infographics
        const paragraphs = Array.from(articleBody.querySelectorAll('p')).filter(p => !p.closest('.infographic-container') && !p.closest('.step-flow-wrapper'));
        const leadText = paragraphs.slice(0, 2).map(p => p.textContent).join(' ');
        
        const headings = Array.from(articleBody.querySelectorAll('h2, h3'))
          .slice(0, 4)
          .map(h => h.textContent?.replace(/^[0-9.\s]+/, '').trim())
          .filter(Boolean);

        let headingsHtml = '';
        if (headings.length > 0) {
          headingsHtml = `
            <div class="sb-key-points">
              <div class="sb-kp-title">${isEn ? '📌 Key Focus Areas in this Article:' : '📌 이 글의 핵심 핵심 체크포인트:'}</div>
              <ul class="sb-kp-list">
                ${headings.map(h => `<li><strong>${h}</strong></li>`).join('')}
              </ul>
            </div>
          `;
        }

        sbBody.innerHTML = `
          <div class="sb-lead-summary">
            <strong>${isEn ? 'Executive Summary:' : '핵심 30초 요약:'}</strong>
            <p>${leadText}</p>
          </div>
          ${headingsHtml}
          <div class="sb-action-box">
            💡 <strong>${isEn ? 'Smart Takeaway:' : '실전 행동 요령:'}</strong> 
            ${isEn 
              ? 'Review the detailed visual infographics and statutory checklists below for exact eligibility and numbers.' 
              : '아래 본문의 인포그래픽 비교 표와 신청 단계별 체크리스트를 통해 정확한 지원 금액과 자격 요건을 확인하세요.'}
          </div>
        `;

        smartWrapper.style.display = 'block';
        smartWrapper.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    } else {
      // Pro Mode
      if (smartWrapper) smartWrapper.style.display = 'none';
      if (existingSmartBox) {
        existingSmartBox.classList.remove('pulse-highlight');
      }
    }
  }

  // Run on page load and Astro view transitions
  initReadingMode();
  document.addEventListener('astro:after-swap', initReadingMode);
</script>

<style>
  .reading-mode-container {
    margin: 1.25rem 0 2rem 0;
    padding: 0.85rem 1.15rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .mode-switch-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .mode-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--text-muted);
  }

  .mode-tabs {
    display: flex;
    align-items: center;
    background: var(--bg-main);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    padding: 0.25rem;
    gap: 0.25rem;
  }

  .mode-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.95rem;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: var(--radius-full);
    color: var(--text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .mode-tab-btn:hover {
    color: var(--text-main);
  }

  .mode-tab-btn.active {
    background: var(--primary);
    color: #ffffff;
    box-shadow: var(--shadow-sm);
  }

  .mode-pill-badge {
    font-size: 0.675rem;
    font-weight: 800;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-full);
    background: #fef08a;
    color: #854d0e;
    margin-left: 0.2rem;
  }

  .mode-tab-btn.active .mode-pill-badge {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  /* Inline Smart Brief Wrapper */
  .smart-brief-wrapper {
    margin-top: 1.25rem;
    animation: fadeIn 0.3s ease-out;
  }

  .smart-brief-box-inline {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.07), rgba(124, 58, 237, 0.07));
    border: 2px solid var(--primary);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
  }

  [data-theme="dark"] .smart-brief-box-inline {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.15), rgba(124, 58, 237, 0.12));
    border-color: #3b82f6;
  }

  .sb-inline-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
    border-bottom: 1px dashed var(--border-color);
  }

  .sb-inline-badge {
    font-size: 0.8rem;
    font-weight: 800;
    color: #ffffff;
    background: var(--primary);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .sb-inline-sub {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  :global(.sb-lead-summary) {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-main);
    margin-bottom: 1rem;
  }

  :global(.sb-lead-summary p) {
    margin: 0.35rem 0 0 0;
  }

  :global(.sb-key-points) {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    margin-bottom: 1rem;
  }

  :global(.sb-kp-title) {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 0.4rem;
  }

  :global(.sb-kp-list) {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-main);
  }

  :global(.sb-action-box) {
    background: var(--bg-card);
    border-left: 4px solid var(--secondary);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-main);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  :global(.pulse-highlight) {
    animation: pulseBorder 1.5s ease;
  }
  @keyframes pulseBorder {
    0% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.4); }
    70% { box-shadow: 0 0 0 10px rgba(37, 99, 235, 0); }
    100% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0); }
  }

  @media (max-width: 640px) {
    .mode-switch-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .mode-tabs {
      width: 100%;
    }
    .mode-tab-btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>
