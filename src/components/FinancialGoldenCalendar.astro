---
interface Props {
  isEn?: boolean;
}

const { isEn = false } = Astro.props;
---

<div class="calendar-widget" id="financial-calendar-container">
  <!-- Widget Header -->
  <div class="widget-header">
    <div class="header-badge">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      <span>{isEn ? '2026 Korea Financial & Tax Golden Calendar' : '2026 세무·정부지원금 골든 캘린더'}</span>
    </div>
    <h2 class="widget-title">
      {isEn ? 'Never Miss a Statutory Deadline: 2026 Financial D-Day Tracker' : '하루만 놓쳐도 수백만 원 손해: 실시간 D-Day 캘린더'}
    </h2>
    <p class="widget-subtitle">
      {isEn 
        ? 'Live D-Day countdowns for tax filing cut-offs, policy subsidies, dividend tax exclusions, and BOK interest rate decisions.' 
        : '종합소득세, 종부세 특례, 해외주식 250만 비과세 매도 컷오프, 한은 금통위 등 놓치면 안 되는 2026 핵심 금융 일정을 실시간 카운트다운합니다.'}
    </p>
  </div>

  <!-- Filter Category Tabs -->
  <div class="calendar-filter-bar">
    <button type="button" class="filter-tab active" data-filter="all">{isEn ? 'All Deadlines' : '전체 일정'}</button>
    <button type="button" class="filter-tab" data-filter="tax">{isEn ? 'Tax & Filing' : '세무·절세 마감'}</button>
    <button type="button" class="filter-tab" data-filter="subsidy">{isEn ? 'Grants & Policy' : '정부지원금·정책'}</button>
    <button type="button" class="filter-tab" data-filter="market">{isEn ? 'BOK & Economy' : '금리·투자 이벤트'}</button>
  </div>

  <!-- Real-Time Countdown Hero Card -->
  <div class="urgent-deadline-card" id="urgent-card-container">
    <!-- Rendered by JS -->
  </div>

  <!-- 12-Month Interactive Grid Timeline -->
  <div class="calendar-timeline-grid" id="timeline-container">
    <!-- Dynamic Month Cards Injected by JS -->
  </div>
</div>

<script>
  interface CalendarEvent {
    month: number;
    day: number;
    year: number;
    titleKo: string;
    titleEn: string;
    type: 'tax' | 'subsidy' | 'market';
    badgeKo: string;
    badgeEn: string;
    descKo: string;
    descEn: string;
    link: string;
  }

  const EVENTS_2026: CalendarEvent[] = [
    {
      month: 1,
      day: 15,
      year: 2026,
      titleKo: '연말정산 간소화 서비스 개통',
      titleEn: 'Year-End Tax Settlement Service Opens',
      type: 'tax',
      badgeKo: '국세청 홈택스',
      badgeEn: 'Hometax',
      descKo: '소득·세액공제 증빙자료 일괄 조회 및 다운로드 개시',
      descEn: 'Official Hometax tax credit receipts available for download',
      link: '/blog/2026-tax-refund-checklist-korea'
    },
    {
      month: 2,
      day: 28,
      year: 2026,
      titleKo: '연말정산 공제서류 최종 제출 마감',
      titleEn: 'Final Year-End Tax Document Deadline',
      type: 'tax',
      badgeKo: '절세 마감',
      badgeEn: 'Tax Deadline',
      descKo: '누락된 월세 세액공제, 안경 구입비, 부양가족 공제 최종 회사 제출',
      descEn: 'Final corporate submission for rent tax credits and medical expenses',
      link: '/blog/2026-tax-refund-checklist-korea'
    },
    {
      month: 3,
      day: 31,
      year: 2026,
      titleKo: '1분기 ISA 연간 납입한도 점검',
      titleEn: 'Q1 ISA Annual Deposit Limit Check',
      type: 'tax',
      badgeKo: '자산관리',
      badgeEn: 'Wealth',
      descKo: 'ISA 연간 2,000만 원(이월 한도 포함) 납입 및 분리과세 포트폴리오 구축',
      descEn: 'Maximize annual 20M KRW tax-free ISA contribution allowance',
      link: '/blog/2026-isa-account-benefits-drawbacks'
    },
    {
      month: 5,
      day: 31,
      year: 2026,
      titleKo: '종합소득세 신고 & 근로장려금 정기 신청',
      titleEn: 'Comprehensive Income Tax & EITC Application',
      type: 'tax',
      badgeKo: '5월 대목',
      badgeEn: 'Annual Filing',
      descKo: '프리랜서(3.3%), 부업 소득자, 금융소득 2,000만 초과자 종소세 확정신고 및 근로장려금(최대 330만 원) 신청',
      descEn: 'Annual statutory tax filing for freelancers and 3.3M KRW EITC subsidy claims',
      link: '/blog/freelancer-comprehensive-income-tax'
    },
    {
      month: 7,
      day: 25,
      year: 2026,
      titleKo: '2026 기획재정부 세법개정안 발표',
      titleEn: '2026 MOEF Tax Reform Bill Announcement',
      type: 'tax',
      badgeKo: '세제개편',
      badgeEn: 'Tax Reform',
      descKo: '고배당 분리과세, 종부세 14억 공제 등 하반기 국회 통과 예정 세법 가이드라인 확인',
      descEn: 'Government tax policy updates including dividend separate taxation',
      link: '/blog/2026-tax-reform-dividend-isa'
    },
    {
      month: 8,
      day: 27,
      year: 2026,
      titleKo: '한국은행 8월 기준금리 결정 & 잭슨홀 미팅',
      titleEn: 'BOK Base Rate Decision & Jackson Hole',
      type: 'market',
      badgeKo: '금리 이벤트',
      badgeEn: 'Interest Rates',
      descKo: '하반기 주담대 6%대 고정금리 vs 변동금리 대환 타이밍 점검 및 파킹통장 금리 리밸런싱',
      descEn: 'Crucial interest rate inflection point for mortgage refinancing decisions',
      link: '/blog/2026-jackson-hole-bok-interest-rate-dilemma'
    },
    {
      month: 9,
      day: 30,
      year: 2026,
      titleKo: '2026 종부세 합산배제 & 1주택 특례 신청 마감',
      titleEn: 'Comprehensive Real Estate Tax Exemption Filing',
      type: 'tax',
      badgeKo: '종부세 특례',
      badgeEn: 'Property Tax',
      descKo: '부부 공동명의 1주택자 특례(14억 기본공제) 및 임대주택 합산배제 신청 마감',
      descEn: 'Deadline for 1.4B KRW single-homeowner property tax deduction special election',
      link: '/blog/2026-comprehensive-real-estate-tax-reform'
    },
    {
      month: 11,
      day: 20,
      year: 2026,
      titleKo: '건강보험료 피부양자 탈락 & 소득 정산 고지',
      titleEn: 'National Health Insurance Exemption Audit',
      type: 'subsidy',
      badgeKo: '건보료 방어',
      badgeEn: 'Health Insurance',
      descKo: '연간 금융소득 2,000만 원 초과 시 피부양자 박탈 및 지역가입자 전환 보험료 폭탄 방어',
      descEn: 'Review passive income thresholds to prevent health insurance dependent disqualification',
      link: '/blog/health-insurance-ceiling-refund-2026'
    },
    {
      month: 12,
      day: 28,
      year: 2026,
      titleKo: '해외주식 250만 원 비과세 매도 결제 컷오프',
      titleEn: 'Overseas Stock 2.5M Tax Exemption Cut-Off',
      type: 'tax',
      badgeKo: '양도세 절세',
      badgeEn: 'Capital Gains',
      descKo: '미국 주식 연간 250만 원 기본공제 활용을 위한 D+2일 결제일 기준 최종 매도 시한',
      descEn: 'Final trade settlement execution date to lock in annual 2.5M KRW capital gains exemption',
      link: '/blog/overseas-stock-capital-gains-tax'
    },
    {
      month: 12,
      day: 31,
      year: 2026,
      titleKo: '연금저축/IRP 연 900만 세액공제 최종 입금 마감',
      titleEn: 'Final IRP / Pension Tax Credit Deposit Deadline',
      type: 'tax',
      badgeKo: '연말정산 마감',
      badgeEn: 'IRP Deadline',
      descKo: '최대 148.5만 원 환급을 받기 위한 IRP 및 연금저축 펀드 2026년도 최종 납입 시한',
      descEn: 'Final statutory deadline to deposit up to 9M KRW for maximum 1.485M KRW tax refund',
      link: '/blog/irp-vs-pension-savings-comparison'
    }
  ];

  let currentFilter = 'all';

  function getDDay(targetYear: number, targetMonth: number, targetDay: number): { text: string; isPast: boolean; days: number } {
    const today = new Date();
    // Normalize to midnight
    const nowMidnight = new Date(today.getFullYear(), today.getMonth(), today.getDate());
    const targetDate = new Date(targetYear, targetMonth - 1, targetDay);

    const diffTime = targetDate.getTime() - nowMidnight.getTime();
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

    if (diffDays === 0) return { text: 'D-Day', isPast: false, days: 0 };
    if (diffDays > 0) return { text: `D-${diffDays}`, isPast: false, days: diffDays };
    return { text: `종료 (D+${Math.abs(diffDays)})`, isPast: true, days: diffDays };
  }

  function updateCalendarUI() {
    const filteredEvents = EVENTS_2026.filter(ev => currentFilter === 'all' || ev.type === currentFilter);

    // Find closest upcoming event
    const upcomingEvents = EVENTS_2026
      .map(ev => ({ ev, dday: getDDay(ev.year, ev.month, ev.day) }))
      .filter(item => !item.dday.isPast)
      .sort((a, b) => a.dday.days - b.dday.days);

    const urgentCard = document.getElementById('urgent-card-container');
    if (urgentCard && upcomingEvents.length > 0) {
      const next = upcomingEvents[0];
      urgentCard.innerHTML = `
        <div class="urgent-inner">
          <div class="urgent-left">
            <span class="urgent-tag">🚨 가장 가까운 금융 D-Day</span>
            <h3 class="urgent-title">${next.ev.titleKo} (${next.ev.month}월 ${next.ev.day}일)</h3>
            <p class="urgent-desc">${next.ev.descKo}</p>
          </div>
          <div class="urgent-right">
            <div class="dday-hero-badge">${next.dday.text}</div>
            <a href="${next.ev.link}" class="btn btn-primary urgent-btn">
              <span>대응 가이드 보기</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        </div>
      `;
    }

    // Render 12-Month Timeline Grid
    const timeline = document.getElementById('timeline-container');
    if (timeline) {
      timeline.innerHTML = filteredEvents.map(ev => {
        const dday = getDDay(ev.year, ev.month, ev.day);
        const badgeColorClass = ev.type === 'tax' ? 'type-tax' : ev.type === 'subsidy' ? 'type-subsidy' : 'type-market';

        return `
          <div class="timeline-event-card ${dday.isPast ? 'event-past' : ''}">
            <div class="te-top">
              <span class="te-month-badge">${ev.month}월 ${ev.day}일</span>
              <span class="te-dday-badge ${dday.isPast ? 'dday-past' : 'dday-active'}">${dday.text}</span>
            </div>
            
            <div class="te-header">
              <span class="te-type-tag ${badgeColorClass}">${ev.badgeKo}</span>
              <h4 class="te-title">${ev.titleKo}</h4>
            </div>

            <p class="te-desc">${ev.descKo}</p>

            <a href="${ev.link}" class="te-link">
              <span>상세 실무 가이드</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        `;
      }).join('');
    }
  }

  // Event Listeners for Filter Tabs
  document.querySelectorAll('.calendar-filter-bar .filter-tab').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.calendar-filter-bar .filter-tab').forEach(b => b.classList.remove('active'));
      const target = e.currentTarget as HTMLButtonElement;
      target.classList.add('active');
      currentFilter = target.getAttribute('data-filter') || 'all';
      updateCalendarUI();
    });
  });

  // Initial Run
  updateCalendarUI();
</script>

<style>
  .calendar-widget {
    background: var(--bg-card);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    box-shadow: var(--shadow-lg);
    margin: 2rem auto;
    max-width: 1100px;
  }

  .widget-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--primary-light);
    color: var(--primary);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 800;
    margin-bottom: 0.85rem;
  }
  .widget-title {
    font-size: clamp(1.6rem, 3.5vw, 2.25rem);
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .widget-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Filter Bar */
  .calendar-filter-bar {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }
  .filter-tab {
    padding: 0.55rem 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-color);
    background: var(--bg-main);
    color: var(--text-muted);
    transition: all 0.15s ease;
  }
  .filter-tab:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
  .filter-tab.active {
    background: var(--primary);
    color: #ffffff;
    border-color: var(--primary);
  }

  /* Urgent Hero Card */
  .urgent-deadline-card {
    margin-bottom: 2rem;
  }
  :global(.urgent-inner) {
    background: linear-gradient(135deg, #eff6ff, #dbeafe);
    border: 2px solid var(--primary);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
    box-shadow: 0 4px 15px rgba(37, 99, 235, 0.12);
  }
  [data-theme="dark"] :global(.urgent-inner) {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.15), rgba(30, 58, 138, 0.3));
    border-color: #3b82f6;
  }
  :global(.urgent-tag) {
    font-size: 0.8rem;
    font-weight: 800;
    color: #b91c1c;
    background: #fee2e2;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    display: inline-block;
    margin-bottom: 0.4rem;
  }
  :global(.urgent-title) {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 0 0 0.35rem 0;
  }
  :global(.urgent-desc) {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
    max-width: 550px;
    line-height: 1.5;
  }
  :global(.urgent-right) {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  :global(.dday-hero-badge) {
    font-size: 1.6rem;
    font-weight: 900;
    color: #ffffff;
    background: var(--primary);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-md);
    letter-spacing: -0.02em;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
  }
  :global(.urgent-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.65rem 1.1rem;
    font-size: 0.85rem;
    font-weight: 800;
    white-space: nowrap;
  }

  /* Timeline Grid */
  .calendar-timeline-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 1.25rem;
  }

  :global(.timeline-event-card) {
    background: var(--bg-main);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  :global(.timeline-event-card:hover) {
    transform: translateY(-2px);
    border-color: var(--primary);
  }
  :global(.timeline-event-card.event-past) {
    opacity: 0.65;
  }

  :global(.te-top) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  :global(.te-month-badge) {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--text-main);
  }
  :global(.te-dday-badge) {
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-full);
  }
  :global(.te-dday-badge.dday-active) {
    background: #dbeafe;
    color: #1d4ed8;
  }
  :global(.te-dday-badge.dday-past) {
    background: var(--bg-muted);
    color: var(--text-light);
  }

  :global(.te-header) {
    margin-bottom: 0.5rem;
  }
  :global(.te-type-tag) {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    display: inline-block;
    margin-bottom: 0.35rem;
  }
  :global(.te-type-tag.type-tax) {
    background: #eff6ff;
    color: #2563eb;
  }
  :global(.te-type-tag.type-subsidy) {
    background: #ecfdf5;
    color: #059669;
  }
  :global(.te-type-tag.type-market) {
    background: #f5f3ff;
    color: #7c3aed;
  }

  :global(.te-title) {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 0;
    line-height: 1.4;
  }
  :global(.te-desc) {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0 0 1rem 0;
    flex: 1;
  }
  :global(.te-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--primary);
    text-decoration: none;
  }
</style>
