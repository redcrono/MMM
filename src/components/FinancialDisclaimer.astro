---
export interface Props {
  customNotice?: string;
  isEn?: boolean;
}

const { customNotice, isEn = false } = Astro.props;
---

<div class="disclaimer-banner" role="note" aria-label={isEn ? "Financial & Tax Disclaimer" : "금융 및 세무 면책 안내"}>
  <svg class="disclaimer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
    <line x1="12" y1="9" x2="12" y2="13"></line>
    <line x1="12" y1="17" x2="12.01" y2="17"></line>
  </svg>
  <div>
    <strong style="color: var(--text-main); display: block; margin-bottom: 0.25rem;">
      {isEn ? "⚖️ MegaMoneyMomentum (MMM) Financial & Tax Disclaimer" : "⚖️ 메가머니모멘텀 YMYL 금융·세무 면책 안내"}
    </strong>
    <p style="margin: 0; line-height: 1.55;">
      {
        customNotice ||
          (isEn
            ? "This article is intended solely for general informational and educational purposes, compiled from official government publications (NTS, MOEF, FSS). Specific tax deductions, visa financial requirements, and loan limits may vary depending on individual circumstances. Please consult a licensed tax accountant (CPTA) or relevant financial institutions for individual advice."
            : "본 게시글은 국세청, 기획재정부, 금융감독원 등 정부 및 공공기관의 공식 발표 자료와 신뢰할 수 있는 데이터를 바탕으로 작성된 일반 정보 제공용 콘텐츠입니다. 세법 해석, 대출 한도, 자산 운용 등의 세부 조건은 개인의 소득, 자격, 시기에 따라 달라질 수 있으므로, 최종 판단 전 반드시 해당 금융기관 또는 세무 전문가와 상담하시기 바랍니다.")
      }
    </p>
  </div>
</div>
