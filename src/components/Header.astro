---
const currentPath = Astro.url.pathname;

const navItems = [
  { name: '절세·세무', href: '/category/tax' },
  { name: '자산관리·ISA', href: '/category/wealth' },
  { name: '정부지원금', href: '/category/subsidy' },
  { name: '대출·신용', href: '/category/credit' },
  { name: '소개', href: '/about' },
];
---

<header class="site-header">
  <div class="container">
    <div class="nav-wrap">
      <!-- Logo Brand -->
      <a href="/" class="logo-brand" aria-label="메가머니모멘텀 홈으로 이동">
        <svg width="28" height="28" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="100" height="100" rx="24" fill="#2563eb" />
          <path d="M50 20 L75 40 L75 80 L25 80 L25 40 Z" fill="none" stroke="#ffffff" stroke-width="6" stroke-linejoin="round" />
          <circle cx="50" cy="55" r="12" fill="#ffffff" />
          <path d="M50 48 L50 62 M44 52 C44 48 56 48 56 55 C56 62 44 62 44 62" stroke="#2563eb" stroke-width="3" stroke-linecap="round" />
        </svg>
        <span>메가머니모멘텀</span>
        <span class="brand-badge">MMM</span>
      </a>

      <!-- Desktop Nav Links -->
      <nav aria-label="메인 메뉴">
        <ul class="nav-links">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class={currentPath.startsWith(item.href) ? 'active' : ''}
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Right Actions (Theme Toggle) -->
      <div class="nav-actions">
        <button id="theme-toggle" class="theme-toggle-btn" aria-label="다크 모드 전환" title="다크 모드 전환">
          <svg id="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg id="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('theme-sun');
  const moonIcon = document.getElementById('theme-moon');

  const currentTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

  function setTheme(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    if (theme === 'dark') {
      sunIcon.style.display = 'block';
      moonIcon.style.display = 'none';
    } else {
      sunIcon.style.display = 'none';
      moonIcon.style.display = 'block';
    }
  }

  setTheme(currentTheme);

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    setTheme(isDark ? 'light' : 'dark');
  });
</script>
