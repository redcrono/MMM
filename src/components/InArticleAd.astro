---
export interface Props {
  slotId?: string;
  adFormat?: 'auto' | 'fluid' | 'rectangle';
  label?: string;
}

const { slotId, adFormat = 'auto', label = '스폰서 링크 / 추천 정보' } = Astro.props;
---

{
  slotId && (
    <div class="ad-slot-container" aria-label="스폰서 영역">
      <span class="ad-label">{label}</span>
      <ins
        class="adsbygoogle"
        style="display:block; text-align:center;"
        data-ad-layout="in-article"
        data-ad-format={adFormat}
        data-ad-client="ca-pub-1414525586943831"
        data-ad-slot={slotId}
      />
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>
  )
}
