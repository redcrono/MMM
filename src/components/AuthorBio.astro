---
export interface Props {
  authorName?: string;
  role?: string;
  bio?: string;
}

const {
  authorName = '메가머니모멘텀 금융데이터 리서치팀',
  role = '금융·세무 공공데이터 팩트체커',
  bio = '국세청 홈택스 고시, 기획재정부 세법 개정안, 금융감독원 상품 공시 데이터를 상시 모니터링하여 복잡한 재테크 및 정책 금융 정보를 독자 눈높이에 맞게 분석·검증합니다.',
} = Astro.props;
---

<div class="author-card" aria-label="작성자 정보">
  <div class="author-avatar" aria-hidden="true">
    MMM
  </div>
  <div class="author-info">
    <h4>{authorName}</h4>
    <div class="author-role">✓ {role}</div>
    <p class="author-bio">{bio}</p>
  </div>
</div>
