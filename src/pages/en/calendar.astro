---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinancialGoldenCalendar from '../../components/FinancialGoldenCalendar.astro';
---

<BaseLayout
  title="2026 Korea Financial & Tax Golden Calendar (Real-Time D-Day Tracker) | MegaMoneyMomentum (MMM)"
  description="Never miss critical statutory deadlines for Korean Income Tax filings, Property Tax exemptions, 2.5M KRW overseas equity exclusions, and BOK interest rate decisions."
>
  <div class="container" style="padding: 1rem 0 4rem 0;">
    <FinancialGoldenCalendar isEn={true} />

    <!-- Explanatory Guide Section -->
    <div style="max-width: 900px; margin: 3rem auto 0 auto; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 2rem; box-shadow: var(--shadow-sm);">
      <h3 style="font-size: 1.35rem; font-weight: 800; color: var(--text-main); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        Statutory Deadline Management in South Korea
      </h3>
      <p style="font-size: 0.95rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 1rem;">
        Missing official statutory tax filing deadlines in South Korea triggers statutory non-filing surcharges (20%) and immediate forfeiture of refundable tax credits.
      </p>
      <ul style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.7; padding-left: 1.25rem; margin-bottom: 1.5rem;">
        <li><strong>Overseas Stock 2.5M KRW Capital Gains Exemption</strong>: Requires trade settlement (T+2) prior to December 28th to register in the current tax year.</li>
        <li><strong>May Comprehensive Income Tax</strong>: Mandatory for expats with non-salary or global passive income above 20M KRW.</li>
        <li><strong>September Property Tax Special Election</strong>: Joint-ownership couples must submit formal election forms to lock in the 1.4B KRW single-home deduction.</li>
      </ul>
      <div style="background: var(--primary-light); border-radius: var(--radius-md); padding: 1rem 1.25rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;">
        <span style="font-size: 0.875rem; font-weight: 700; color: var(--primary);">Simulate 10-year compounding returns across 6 major assets</span>
        <a href="/en/battle" style="font-size: 0.85rem; font-weight: 800; color: var(--primary); text-decoration: underline;">Open Asset Compounding Battle ➔</a>
      </div>
    </div>
  </div>
</BaseLayout>
