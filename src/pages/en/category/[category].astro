---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const categories = [
    { slug: 'tax', name: 'Tax & Expat Settlement', desc: 'Yeonmaljeongsan, Global Income Tax, Capital Gains Tax & Expat 19% Flat Rate Guides' },
    { slug: 'wealth', name: 'Wealth & Investment', desc: 'ISA Tax-Free Accounts, IRP Pensions, US Index ETFs & High-Yield Banking Systems' },
    { slug: 'subsidy', name: 'Living & Subsidies', desc: '2026 Youth Housing Grants, Health Insurance Refunds & Travel Payment Cards' },
    { slug: 'credit', name: 'Banking & Credit', desc: 'Opening Accounts without ARC, Credit Score 900+ & Low-Fee Emergency Loans' },
  ];

  const allPosts = await getCollection('blog');

  return categories.map((cat) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.category === cat.slug && (post.slug.startsWith('en-') || post.slug.startsWith('korea-') || post.slug.startsWith('open-') || post.slug.startsWith('best-korea-') || post.slug.includes('-expats') || post.slug.includes('-foreigners') || post.slug.includes('travel-cards')))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { category: cat.slug },
      props: {
        categoryInfo: cat,
        posts: filteredPosts,
      },
    };
  });
}

const { categoryInfo, posts } = Astro.props;
---

<BaseLayout
  title={`${categoryInfo.name} | MegaMoneyMomentum (MMM)`}
  description={categoryInfo.desc}
>
  <div class="container" style="padding: 2.5rem 0 4rem 0;">
    <!-- Category Hero Header -->
    <header style="margin-bottom: 2.5rem; text-align: center; border-bottom: 2px solid var(--border-color); padding-bottom: 2rem;">
      <div style="display: inline-block; background: var(--primary-light); color: var(--primary); padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.85rem; font-weight: 700; margin-bottom: 0.75rem;">
        Category Archive
      </div>
      <h1 style="font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; color: var(--text-main); margin-bottom: 0.75rem;">
        {categoryInfo.name}
      </h1>
      <p style="font-size: 1.05rem; color: var(--text-muted); max-width: 600px; margin: 0 auto; line-height: 1.6;">
        {categoryInfo.desc}
      </p>
      <div style="margin-top: 1rem; font-size: 0.875rem; color: var(--text-light);">
        Total <strong>{posts.length}</strong> verified reports available
      </div>
    </header>

    <!-- Post Grid -->
    {posts.length > 0 ? (
      <div class="blog-grid">
        {posts.map((post) => (
          <article class="blog-card">
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class={`badge-category badge-${post.data.category}`}>
                  {post.data.categoryName}
                </span>
                <span>•</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(post.data.pubDate)}
                </time>
              </div>
              <h2 class="blog-card-title">
                <a href={`/blog/${post.slug}`} style="color: inherit;">
                  {post.data.title}
                </a>
              </h2>
              <p class="blog-card-desc">{post.data.description}</p>
              <div class="blog-card-footer">
                <a href={`/blog/${post.slug}`} style="display: inline-flex; align-items: center; gap: 0.35rem; color: var(--primary);">
                  Read Full Guide <span>→</span>
                </a>
                <span style="font-size: 0.8rem; color: var(--text-light);">
                  ⏱️ {post.data.readingTime}
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div style="text-align: center; padding: 4rem 0; background: var(--bg-card); border-radius: var(--radius-md); border: 1px dashed var(--border-color);">
        <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 1rem;">
          No posts currently found in this category.
        </p>
        <a href="/en" class="btn btn-primary">Return to English Home</a>
      </div>
    )}
  </div>
</BaseLayout>
