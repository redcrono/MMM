---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TaxSavingsCalculator from '../../components/TaxSavingsCalculator.astro';

const allPosts = await getCollection('blog');
const enPosts = allPosts.filter(
  (p) => p.slug.startsWith('en-') || p.slug.startsWith('korea-') || p.slug.startsWith('open-') || p.slug.startsWith('best-korea-') || p.slug.includes('-expats') || p.slug.includes('-foreigners') || p.slug.includes('travel-cards')
);
const sortedPosts = enPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [
  {
    slug: 'economy',
    name: 'Market & Economy Trends',
    desc: 'BOK rate decisions, Seoul Stress DSR, and macroeconomic analysis',
    color: '#be185d',
    bg: '#fdf2f8',
    iconPath: 'M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z',
  },
  {
    slug: 'tax',
    name: 'Tax & Expat Settlement',
    desc: 'Yeonmaljeongsan, Global Income Tax, Capital Gains & 19% Flat Rate',
    color: 'var(--primary)',
    bg: 'var(--primary-light)',
    iconPath: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8',
  },
  {
    slug: 'wealth',
    name: 'Wealth & Investment',
    desc: 'ISA Tax-Free Accounts, IRP, US Index ETFs & High-Yield Banking',
    color: 'var(--accent-purple)',
    bg: 'var(--accent-purple-light)',
    iconPath: 'M23 6l-9.5 9.5-5-5L1 18 M17 6h6v6',
  },
  {
    slug: 'subsidy',
    name: 'Living & Subsidies',
    desc: '2026 Youth Housing Grants, Health Insurance Refunds & Travel Money',
    color: 'var(--accent-amber)',
    bg: 'var(--accent-amber-light)',
    iconPath: 'M3 21h18 M6 18V11 M10 18V11 M14 18V11 M18 18V11 M12 2l8 5H4z',
  },
  {
    slug: 'credit',
    name: 'Banking & Credit',
    desc: 'Bank Accounts without ARC, Credit Score 900+ & Low-Fee Loans',
    color: 'var(--secondary)',
    bg: 'var(--secondary-light)',
    iconPath: 'M1 4h22v16H1z M1 10h22',
  },
];
---

<BaseLayout
  title="MegaMoneyMomentum (MMM) | Korea Finance, Tax & Living Guide for Expats & Global Citizens"
  description="Fact-checked digital finance media based on official National Tax Service, MOEF, and Bank of Korea data. Year-end tax settlements, ISA accounts, and living guides in South Korea."
>
  <!-- Hero Section -->
  <section class="container" style="text-align: center; padding: 2rem 0 3.5rem 0;">
    <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--primary-light); color: var(--primary); padding: 0.4rem 1rem; border-radius: var(--radius-full); font-size: 0.85rem; font-weight: 700; margin-bottom: 1.25rem;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18h6"></path>
        <path d="M10 22h4"></path>
        <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"></path>
      </svg>
      <span>2026 Latest Korea Finance & Tax Regulations</span>
    </div>
    <h1 style="font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.25; margin-bottom: 1.25rem; color: var(--text-main);">
      Complex Korean Finance & Taxes,<br />
      Demystified with <span style="color: var(--primary);">Facts and Verified Data</span>.
    </h1>
    <p style="font-size: 1.15rem; color: var(--text-muted); max-width: 680px; margin: 0 auto 2.5rem auto; line-height: 1.7; word-break: keep-all;">
      Fact-checked by our data research team against official National Tax Service (NTS) and Financial Supervisory Service (FSS) standards to help expats and global investors protect and grow their wealth.
    </p>

    <!-- Category Quick Navigation -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-top: 1.5rem;">
      {
        categories.map((c) => (
          <a
            href={`/en/category/${c.slug}`}
            style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.25rem; text-align: left; transition: all 0.2s ease; box-shadow: var(--shadow-sm);"
            class="category-hover-card"
          >
            <div style={`width: 2.75rem; height: 2.75rem; border-radius: var(--radius-md); background: ${c.bg}; color: ${c.color}; display: flex; align-items: center; justify-content: center; margin-bottom: 0.75rem;`}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={c.iconPath} />
              </svg>
            </div>
            <h2 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.35rem;">
              {c.name}
            </h2>
            <p style="font-size: 0.825rem; color: var(--text-muted); line-height: 1.5; margin: 0;">
              {c.desc}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Interactive Calculator Section -->
  <section class="container" style="margin-bottom: 3rem;">
    <TaxSavingsCalculator />
  </section>

  <!-- Latest Articles Section -->
  <section class="container">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 2px solid var(--border-color);">
      <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-main); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z"></path>
        </svg>
        Real-Time Expat Finance & Tax Guides
      </h2>
      <span style="font-size: 0.875rem; color: var(--text-muted); font-weight: 600;">Total {enPosts.length} Verified Reports</span>
    </div>

    <div class="blog-grid">
      {
        sortedPosts.map((post) => (
          <article class="blog-card">
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class={`badge-category badge-${post.data.category}`}>
                  {post.data.categoryName}
                </span>
                <span>•</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(post.data.pubDate)}
                </time>
              </div>
              <h3 class="blog-card-title">
                <a href={`/blog/${post.slug}`} style="color: inherit;">
                  {post.data.title}
                </a>
              </h3>
              <p class="blog-card-desc">{post.data.description}</p>
              <div class="blog-card-footer">
                <a href={`/blog/${post.slug}`} style="display: inline-flex; align-items: center; gap: 0.35rem; color: var(--primary);">
                  Read Full Guide 
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
                <span style="font-size: 0.8rem; color: var(--text-light); display: inline-flex; align-items: center; gap: 0.3rem;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  {post.data.readingTime}
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .category-hover-card:hover {
    transform: translateY(-3px);
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }
</style>
