---
import BaseLayout from '../layouts/BaseLayout.astro';

const qnaCategories = [
  {
    category: '세무·절세',
    badge: 'badge-tax',
    items: [
      {
        q: '가족 간 2억 1,700만 원 무이자 차용증을 작성할 때 반드시 공증을 받아야 하나요?',
        a: '공증이 법적 필수는 아니지만, 국세청 세무조사 시 자금 대여의 진실성을 소급 인정받기 위해 우체국 내용증명(확정일자)이나 공증을 받아두는 것이 절대적으로 안전합니다. 상증세법 제41조의4에 따라 무이자 차용 한도는 최대 2억 1,700만 원(연 이자 1,000만 원 미만 비과세)입니다.',
        link: '/blog/family-loan-agreement-gift-tax',
        linkText: '가족 간 차용증 작성법 및 2.17억 무이자 가이드 읽기'
      },
      {
        q: '프리랜서 3.3% 사업소득자는 단순경비율과 기준경비율 중 어느 것이 유리한가요?',
        a: '연 수입 2,400만 원 미만인 경우 증빙 없이 약 60% 안팎을 비용으로 인정해 주는 단순경비율이 압도적으로 유리합니다. 하지만 수입이 2,400만 원을 초과하면 기준경비율(10~20%)로 떨어져 세금 폭탄을 맞으므로, 반드시 간편장부를 작성하고 카드 내역·통신비·임차료 영수증을 모아야 합니다.',
        link: '/blog/freelancer-comprehensive-income-tax',
        linkText: '프리랜서 3.3% 종합소득세 및 간편장부 절세 가이드 읽기'
      },
      {
        q: '1주택자 종합부동산세 기본공제 14억 원은 시가로 얼마 정도인가요?',
        a: '공시가격 현실화율(약 69%)을 감안할 때 공시가격 14억 원은 시가 약 20억 원 안팎에 해당합니다. 따라서 시가 20억 원 이하의 1세대 1주택자는 종부세가 0원(전액 면제)입니다.',
        link: '/blog/2026-comprehensive-real-estate-tax-reform',
        linkText: '2026 종합부동산세 개편안 및 14억 공제 계산법 읽기'
      }
    ]
  },
  {
    category: '주식·ETF 투자',
    badge: 'badge-stocks',
    items: [
      {
        q: '해외주식 250만 원 양도세 기본공제는 매년 12월 언제까지 팔아야 인정되나요?',
        a: '미국 주식은 매도 체결일로부터 결제일까지 T+1일(영업일 기준 1일)이 소요됩니다. 따라서 12월 31일 폐장일을 고려하여 최소 12월 29일~30일 이전에 매도 체결을 완료해야 당해 연도 250만 원 공제 실적으로 확정됩니다.',
        link: '/blog/overseas-stock-capital-gains-tax',
        linkText: '해외주식 250만원 공제 및 손익통산 가이드 읽기'
      },
      {
        q: 'QQQ와 QQQM은 무엇이 다르고 왜 QQQM이 개인에게 유리한가요?',
        a: '두 ETF 모두 Invesco에서 운용하며 나스닥100 지수를 100% 동일하게 추종합니다. 하지만 QQQM은 연간 총보수가 0.15%로 QQQ(0.20%)보다 25% 저렴하며, 1주당 단가가 200달러대로 낮아 소액 적립식 투자 시 수수료를 수천만 원 절약할 수 있습니다.',
        link: '/blog/us-etf-qqqm-vs-qqq-difference',
        linkText: 'QQQ vs QQQM 수수료 비교 및 20년 복리 시뮬레이션 읽기'
      },
      {
        q: 'SCHD와 JEPI 중 30대 직장인에게 적합한 배당 ETF는 무엇인가요?',
        a: '당장 배당금을 생활비로 쓰지 않고 10년 이상 자산을 불려 나갈 30대에게는 배당금이 매년 10% 안팎으로 복리 성장하고 주가도 상승하는 SCHD가 장기적으로 압도적으로 유리합니다. JEPI는 매달 8% 안팎의 즉각적인 현금흐름이 필요한 은퇴자에게 적합합니다.',
        link: '/blog/schd-vs-jepi-monthly-dividend-comparison',
        linkText: 'SCHD vs JEPI 10년 투자 배당금 역전 시뮬레이션 읽기'
      }
    ]
  },
  {
    category: '자산관리·ISA',
    badge: 'badge-wealth',
    items: [
      {
        q: '중개형 ISA 계좌에서 만기 3년 후 해지한 돈을 IRP로 넣으면 세금이 어떻게 되나요?',
        a: 'ISA 만기 자금을 60일 이내에 연금저축/IRP로 전환 입금하면, 전환 금액의 10%(최대 300만 원 한도)까지 추가 세액공제(16.5% 적용 시 최대 49.5만 원 추가 환급) 혜택을 누릴 수 있습니다.',
        link: '/blog/2026-isa-account-benefits-drawbacks',
        linkText: '2026 중개형 ISA 비과세 한도 및 IRP 연계 전략 읽기'
      },
      {
        q: '2026년 신설된 생산적 금융 ISA는 기존 ISA와 무엇이 다른가요?',
        a: '생산적 금융 ISA는 국내 상장 주식 및 국내 주식형 펀드에만 투자할 수 있는 전용 계좌로, 계좌 내에서 발생하는 모든 이자·배당소득에 대해 한도 제한 없이 100% 완전 비과세 혜택이 주어집니다.',
        link: '/blog/2026-tax-reform-dividend-isa',
        linkText: '2026 세법개정안 생산적금융 ISA 상세 가이드 읽기'
      }
    ]
  },
  {
    category: '대출·신용관리',
    badge: 'badge-credit',
    items: [
      {
        q: '마이너스통장은 돈을 1원도 안 쓰고 잔액이 0원이어도 주택담보대출 한도가 깎이나요?',
        a: '네, 크게 깎입니다. DSR 규정상 마이너스통장은 실제 사용액이 아니라 개설된 약정 한도 전액을 5년 만기 분할상환 부채로 산정합니다. 한도 5,000만 원 마통을 열어두면 주담대 한도가 1억 5천만 원 이상 증발할 수 있으므로 주담대 실행 전 해지하거나 감액해야 합니다.',
        link: '/blog/minus-bankbook-dsr-limit-guide',
        linkText: '마이너스통장 DSR 한도 산정법 및 주담대 전 관리법 읽기'
      },
      {
        q: '금리인하요구권은 1년에 몇 번까지 신청할 수 있으며 거절 시 불이익이 있나요?',
        a: '법적으로 신청 횟수 제한이 없습니다. 승진, 연봉 인상, 신용점수 상승 등 상태 개선이 있을 때마다 수시로 신청할 수 있으며, 거절당하더라도 신용점수나 은행 거래에 0.1%의 불이익도 없습니다.',
        link: '/blog/loan-interest-rate-reduction-right',
        linkText: '금리인하요구권 승인율 높이는 꿀팁 및 거절 대응법 읽기'
      }
    ]
  },
  {
    category: '정부지원금·정책',
    badge: 'badge-subsidy',
    items: [
      {
        q: '청년도약계좌를 5년 다 못 채우고 3년 만에 중도 해지하면 정부기여금을 못 받나요?',
        a: '2026 개편안에 따라 가입 후 3년 이상 유지하고 해지할 경우 15.4% 비과세 혜택이 100% 정상 적용되며, 정부 기여금도 60% 수준까지 부분 지급받을 수 있습니다. 또한 결혼, 출산, 생애최초 주택구입 시에는 특별중도해지로 인정되어 5년 만기와 동일하게 100% 전액 수령합니다.',
        link: '/blog/youth-future-savings-vs-jump-account',
        linkText: '청년도약계좌 5,000만원 형성 및 중도해지 방지법 읽기'
      },
      {
        q: '신생아 특례 주택담보대출은 DSR 규제가 면제되나요?',
        a: '네, DSR 규제가 100% 전면 면제되고 LTV(최대 80%)와 DTI(최대 60%)만 적용됩니다. 따라서 소득이 적더라도 주택 가격의 최대 80%(최대 5억 원)까지 1.6%~3.3% 초저금리로 대출을 받을 수 있습니다.',
        link: '/blog/newborn-special-mortgage-loan-2026',
        linkText: '2026 신생아 특례 주담대 1.6% 대출 가이드 읽기'
      }
    ]
  }
];

// Generate JSON-LD Schema for Google FAQPage
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": qnaCategories.flatMap((cat) =>
    cat.items.map((item) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  )
};
---

<BaseLayout
  title="금융 실무 Q&A 센터 | 메가머니모멘텀 (MMM)"
  description="세무, 주식·ETF, ISA 절세계좌, 대출·신용관리, 2026 정부지원금 관련 독자 빈출 핵심 질문 TOP 20과 명쾌한 법적 팩트체크 답변."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="container" style="padding: 2rem 0 4rem 0;">
    <!-- Q&A Hero Header -->
    <header style="text-align: center; margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border-color);">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--primary-light); color: var(--primary); padding: 0.4rem 1rem; border-radius: var(--radius-full); font-size: 0.85rem; font-weight: 700; margin-bottom: 1rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
        <span>금융 데이터 리서치팀 팩트체크</span>
      </div>
      <h1 style="font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 800; color: var(--text-main); margin-bottom: 0.75rem;">
        금융 실무 <span style="color: var(--primary);">Q&A 센터</span>
      </h1>
      <p style="font-size: 1.1rem; color: var(--text-muted); max-width: 650px; margin: 0 auto; line-height: 1.6;">
        국세청, 기재부, 금융감독원 공식 법률과 고시에 기반하여 독자분들이 가장 많이 질문하시는 핵심 금융·세무 궁금증을 명쾌하게 해결해 드립니다.
      </p>
    </header>

    <!-- Q&A Accordion Sections -->
    <div style="display: flex; flex-direction: column; gap: 2.5rem; max-width: 900px; margin: 0 auto;">
      {
        qnaCategories.map((cat) => (
          <section style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.5rem 2rem; box-shadow: var(--shadow-sm);">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem; padding-bottom: 0.75rem; border-bottom: 2px solid var(--border-color);">
              <span class={`badge-category ${cat.badge}`} style="font-size: 0.9rem; padding: 0.35rem 0.85rem;">{cat.category}</span>
              <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin: 0;">자주 묻는 핵심 질문</h2>
            </div>

            <div style="display: flex; flex-direction: column; gap: 1.25rem;">
              {
                cat.items.map((item) => (
                  <details style="background: var(--bg-main); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1rem 1.25rem; cursor: pointer; transition: all 0.2s ease;">
                    <summary style="font-weight: 700; font-size: 1.05rem; color: var(--text-main); line-height: 1.5; outline: none;">
                      Q. {item.q}
                    </summary>
                    <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed var(--border-color); font-size: 0.95rem; color: var(--text-muted); line-height: 1.7;">
                      <p style="margin: 0 0 0.75rem 0;">💡 <strong>답변:</strong> {item.a}</p>
                      <a href={item.link} style="display: inline-flex; align-items: center; gap: 0.35rem; color: var(--primary); font-weight: 700; font-size: 0.875rem; text-decoration: none;">
                        <span>{item.linkText}</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </a>
                    </div>
                  </details>
                ))
              }
            </div>
          </section>
        ))
      }
    </div>

    <!-- Contact & Custom Question Card -->
    <div style="max-width: 900px; margin: 3.5rem auto 0 auto; background: linear-gradient(135deg, var(--primary-light), var(--bg-card)); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 2rem; text-align: center;">
      <h3 style="font-size: 1.35rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.5rem;">
        찾으시는 질문이 없으신가요?
      </h3>
      <p style="font-size: 0.95rem; color: var(--text-muted); max-width: 550px; margin: 0 auto 1.5rem auto; line-height: 1.6;">
        금융, 세무, 대출 관련하여 복잡한 고민이나 궁금한 점이 있으시다면 언제든지 문의해 주세요. 리서치팀이 검증 후 답변해 드립니다.
      </p>
      <a href="/contact" class="btn btn-primary" style="padding: 0.75rem 1.75rem; font-size: 0.95rem; font-weight: 700; border-radius: var(--radius-full); display: inline-flex; align-items: center; gap: 0.5rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>1:1 금융 질문 및 문의 남기기</span>
      </a>
    </div>
  </div>
</BaseLayout>
