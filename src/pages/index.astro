---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TaxSavingsCalculator from '../components/TaxSavingsCalculator.astro';

const allPosts = await getCollection('blog');
const koPosts = allPosts.filter(
  (p) => !p.slug.startsWith('en-') && !p.slug.startsWith('korea-') && !p.slug.startsWith('open-') && !p.slug.startsWith('best-korea-')
);
const sortedPosts = koPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [
  {
    slug: 'economy',
    name: '경제 트렌드·이슈',
    desc: '한국은행 기준금리, 수도권 스트레스 DSR, 잭슨홀 거시경제 분석',
    color: '#be185d',
    bg: '#fdf2f8',
    iconPath: 'M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z',
    count: koPosts.filter((p) => p.data.category === 'economy').length,
  },
  {
    slug: 'tax',
    name: '절세·세무 실무',
    desc: '연말정산, 종합소득세, 양도·증여세, 2026 종부세 개편안',
    color: 'var(--primary)',
    bg: 'var(--primary-light)',
    iconPath: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8',
    count: koPosts.filter((p) => p.data.category === 'tax').length,
  },
  {
    slug: 'stocks',
    name: '주식·ETF 투자',
    desc: 'S&P500·나스닥100 복리 투자, 미국 고배당 ETF(SCHD/JEPI), 해외주식 양도세',
    color: '#2563eb',
    bg: '#eff6ff',
    iconPath: 'M3 3v18h18 M18 9l-5 5-4-4-6 6',
    count: koPosts.filter((p) => p.data.category === 'stocks').length,
  },
  {
    slug: 'wealth',
    name: '자산관리·ISA',
    desc: '생산적금융 ISA, IRP, 연금저축펀드, 개인투자용 국채, 고금리 파킹통장',
    color: 'var(--accent-purple)',
    bg: 'var(--accent-purple-light)',
    iconPath: 'M23 6l-9.5 9.5-5-5L1 18 M17 6h6v6',
    count: koPosts.filter((p) => p.data.category === 'wealth').length,
  },
  {
    slug: 'subsidy',
    name: '정부지원금·정책',
    desc: '2026 청년도약계좌, 월세지원, 신생아특례 주담대, 내일배움카드',
    color: 'var(--accent-amber)',
    bg: 'var(--accent-amber-light)',
    iconPath: 'M3 21h18 M6 18V11 M10 18V11 M14 18V11 M18 18V11 M12 2l8 5H4z',
    count: koPosts.filter((p) => p.data.category === 'subsidy').length,
  },
  {
    slug: 'credit',
    name: '대출·신용관리',
    desc: '신용점수 900점 올리기, 금리인하요구권, 마이너스통장 DSR 산정법',
    color: 'var(--secondary)',
    bg: 'var(--secondary-light)',
    iconPath: 'M1 4h22v16H1z M1 10h22',
    count: koPosts.filter((p) => p.data.category === 'credit').length,
  },
];

const specialHubs = [
  {
    href: '/ladder',
    name: '부의 사다리 & 절세 건강검진',
    desc: '내 순자산 상위 백분위(%) 및 연간 놓치고 있는 숨은 절세액 진단',
    badge: '👑 바이럴 진단기',
    color: 'var(--primary)',
    bg: 'var(--primary-light)',
    iconPath: 'M12 2v20 M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6',
  },
  {
    href: '/battle',
    name: '6대 자산 복리 배틀 시뮬레이터',
    desc: '1억 원 10년 굴리기: S&P500, QQQM, SCHD(월배당금), 국채 실시간 비교',
    badge: '📈 10년 복리',
    color: 'var(--secondary)',
    bg: 'var(--secondary-light)',
    iconPath: 'M18 20V10 M12 20V4 M6 20v-6',
  },
  {
    href: '/calendar',
    name: '2026 금융 골든 캘린더',
    desc: '종합소득세, 종부세 특례, 해외주식 250만 비과세 마감 실시간 D-Day',
    badge: '📅 D-Day 알리미',
    color: 'var(--accent-amber)',
    bg: 'var(--accent-amber-light)',
    iconPath: 'M3 4h18v18H3z M16 2v4 M8 2v4 M3 10h18',
  },
  {
    href: '/tools',
    name: '금융 계산기 & 시뮬레이터',
    desc: '연말정산 환급금, DSR 주담대 한도, 파킹통장 일복리 모의계산 허브',
    badge: '인터랙티브 허브',
    color: 'var(--primary)',
    bg: 'var(--primary-light)',
    iconPath: 'M4 2h16a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z M8 6h8 M16 14v4 M12 10h.01 M16 10h.01 M8 10h.01 M12 14h.01 M8 14h.01 M12 18h.01 M8 18h.01',
  },
  {
    href: '/qna',
    name: '금융 실무 Q&A 센터',
    desc: '세무, 주식, ISA, 대출 독자 빈출 질문 TOP 20 & 1:1 질문하기',
    badge: 'FAQ 센터',
    color: 'var(--accent-purple)',
    bg: 'var(--accent-purple-light)',
    iconPath: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3 M12 17h.01',
  },
  {
    href: '/category/expats',
    name: '외국인 금융·생활 가이드',
    desc: '외국인 계좌개설, 건강보험료 환급, 연말정산 19% 단일세율',
    badge: 'EXPATS HUB',
    color: 'var(--secondary)',
    bg: 'var(--secondary-light)',
    iconPath: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M2 12h20 M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z',
  },
];
---

<BaseLayout
  title="메가머니모멘텀(MegaMoneyMomentum) | 2026 대한민국 금융·세무·정책 나침반"
  description="국세청, 기획재정부, 금융감독원 공공데이터 기반 팩트체크 금융 미디어. 연말정산 절세, 중개형 ISA 비과세 혜택, 2026 정부지원금 신청 자격 총정리."
>
  <!-- Hero Section -->
  <section class="container hero-section">
    <div class="hero-badge">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18h6"></path>
        <path d="M10 22h4"></path>
        <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"></path>
      </svg>
      <span>2026 최신 세법 및 금융 정책 완벽 반영</span>
    </div>
    <h1 class="hero-title">
      어려운 금융·세무·정책 정보,<br />
      <span class="text-gradient">팩트와 데이터</span>로 가장 명쾌하게.
    </h1>
    <p class="hero-desc">
      국세청, 금융감독원 공식 고시를 직접 검증하여 광고성 정보 없이 실질적으로 내 돈을 지키고 불리는 절세 및 지원금 가이드를 제공합니다.
    </p>
  </section>

  <!-- Section 1: 6 Core Categories (3x2 Grid) -->
  <section class="container" style="margin-bottom: 3.5rem;">
    <div class="section-header">
      <div>
        <h2 class="section-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          분야별 핵심 금융·세무 가이드
        </h2>
        <p class="section-subtitle">원하시는 금융 카테고리를 선택하여 심층 분석 리포트를 확인하세요.</p>
      </div>
      <span class="section-tag">6대 전문 섹터</span>
    </div>

    <div class="card-grid grid-3x2">
      {
        categories.map((c) => (
          <a href={`/category/${c.slug}`} class="unified-nav-card">
            <div class="card-top">
              <div class="card-icon-box" style={`background: ${c.bg}; color: ${c.color};`}>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d={c.iconPath} />
                </svg>
              </div>
              <span class="card-meta-badge">{c.count}편 수록</span>
            </div>
            <h3 class="card-title">{c.name}</h3>
            <p class="card-desc">{c.desc}</p>
            <div class="card-action">
              <span>가이드 보기</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Section 2: 3 Interactive Special Hubs (3x1 Grid) -->
  <section class="container" style="margin-bottom: 3.5rem;">
    <div class="section-header">
      <div>
        <h2 class="section-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent-purple)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          인터랙티브 금융 허브 & Q&A
        </h2>
        <p class="section-subtitle">실시간 계산기와 독자 질문 해결 센터를 바로 이용해 보세요.</p>
      </div>
      <span class="section-tag" style="background: var(--accent-purple-light); color: var(--accent-purple);">스페셜 서비스</span>
    </div>

    <div class="card-grid grid-3x1">
      {
        specialHubs.map((h) => (
          <a href={h.href} class="unified-nav-card special-hub-card">
            <div class="card-top">
              <div class="card-icon-box" style={`background: ${h.bg}; color: ${h.color};`}>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d={h.iconPath} />
                </svg>
              </div>
              <span class="card-badge-pill" style={`background: ${h.bg}; color: ${h.color};`}>{h.badge}</span>
            </div>
            <h3 class="card-title">{h.name}</h3>
            <p class="card-desc">{h.desc}</p>
            <div class="card-action" style={`color: ${h.color};`}>
              <span>바로가기</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Section 3: Interactive Calculator Section -->
  <section class="container" style="margin-bottom: 3.5rem;">
    <TaxSavingsCalculator />
  </section>

  <!-- Section 4: Latest Articles Grid -->
  <section class="container">
    <div class="section-header">
      <div>
        <h2 class="section-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z"></path>
          </svg>
          실시간 금융·세무 심층 리포트
        </h2>
        <p class="section-subtitle">매일 갱신되는 최신 법률 및 정책 팩트체크 리포트</p>
      </div>
      <span class="section-tag">총 {koPosts.length}편 수록</span>
    </div>

    <div class="blog-grid">
      {
        sortedPosts.map((post) => (
          <article class="blog-card">
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class={`badge-category badge-${post.data.category}`}>
                  {post.data.categoryName}
                </span>
                <span>•</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'short', day: 'numeric' }).format(post.data.pubDate)}
                </time>
              </div>
              <h3 class="blog-card-title">
                <a href={`/blog/${post.slug}`} style="color: inherit;">
                  {post.data.title}
                </a>
              </h3>
              <p class="blog-card-desc">{post.data.description}</p>
              <div class="blog-card-footer">
                <a href={`/blog/${post.slug}`} style="display: inline-flex; align-items: center; gap: 0.35rem; color: var(--primary);">
                  상세 가이드 읽기 
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
                <span style="font-size: 0.8rem; color: var(--text-light); display: inline-flex; align-items: center; gap: 0.3rem;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  {post.data.readingTime}
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    text-align: center;
    padding: 1.5rem 0 3rem 0;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--primary-light);
    color: var(--primary);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }
  .hero-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.25;
    margin-bottom: 1.25rem;
    color: var(--text-main);
  }
  .text-gradient {
    color: var(--primary);
  }
  .hero-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.7;
    word-break: keep-all;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--border-color);
  }
  .section-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 0 0 0.25rem 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .section-subtitle {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }
  .section-tag {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--primary);
    background: var(--primary-light);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .card-grid {
    display: grid;
    gap: 1.25rem;
  }
  .grid-3x2, .grid-3x1 {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .unified-nav-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.35rem;
    text-align: left;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .unified-nav-card:hover {
    transform: translateY(-3px);
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .card-icon-box {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .card-meta-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-light);
    background: var(--bg-main);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
  }
  .card-badge-pill {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
  }
  .card-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 0 0 0.4rem 0;
  }
  .card-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0 0 1.25rem 0;
    flex: 1;
  }
  .card-action {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
</style>
