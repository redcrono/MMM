---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TaxSavingsCalculator from '../components/TaxSavingsCalculator.astro';

const allPosts = await getCollection('blog');
const koPosts = allPosts.filter(
  (p) => !p.slug.startsWith('en-') && !p.slug.startsWith('korea-') && !p.slug.startsWith('open-') && !p.slug.startsWith('best-korea-')
);
const sortedPosts = koPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [
  {
    slug: 'economy',
    name: '경제 트렌드·이슈',
    desc: '한국은행 기준금리, 수도권 스트레스 DSR, 잭슨홀 거시경제 분석',
    color: '#be185d',
    bg: '#fdf2f8',
    iconPath: 'M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z',
  },
  {
    slug: 'tax',
    name: '절세·세무 실무',
    desc: '연말정산, 종합소득세, 양도·증여세, 2026 종부세 개편안',
    color: 'var(--primary)',
    bg: 'var(--primary-light)',
    iconPath: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8',
  },
  {
    slug: 'stocks',
    name: '주식·ETF 투자',
    desc: 'S&P500·나스닥100 복리 투자, 미국 고배당 ETF(SCHD/JEPI), 해외주식 양도세',
    color: '#2563eb',
    bg: '#eff6ff',
    iconPath: 'M3 3v18h18 M18 9l-5 5-4-4-6 6',
  },
  {
    slug: 'wealth',
    name: '자산관리·ISA',
    desc: '생산적금융 ISA, IRP, 연금저축펀드, 개인투자용 국채, 고금리 파킹통장',
    color: 'var(--accent-purple)',
    bg: 'var(--accent-purple-light)',
    iconPath: 'M23 6l-9.5 9.5-5-5L1 18 M17 6h6v6',
  },
  {
    slug: 'subsidy',
    name: '정부지원금·정책',
    desc: '2026 청년도약계좌, 월세지원, 신생아특례 주담대, 내일배움카드',
    color: 'var(--accent-amber)',
    bg: 'var(--accent-amber-light)',
    iconPath: 'M3 21h18 M6 18V11 M10 18V11 M14 18V11 M18 18V11 M12 2l8 5H4z',
  },
  {
    slug: 'credit',
    name: '대출·신용관리',
    desc: '신용점수 900점 올리기, 금리인하요구권, 마이너스통장 DSR 산정법',
    color: 'var(--secondary)',
    bg: 'var(--secondary-light)',
    iconPath: 'M1 4h22v16H1z M1 10h22',
  },
];

const specialHubs = [
  {
    href: '/tools',
    name: '금융 계산기 & 시뮬레이터',
    desc: '연말정산 환급금, DSR 대출 한도, 파킹통장 일복리 실시간 모의계산',
    badge: 'INTERACTIVE',
    color: 'var(--primary)',
    bg: 'var(--primary-light)',
    icon: '📊',
  },
  {
    href: '/qna',
    name: '금융 실무 Q&A 센터',
    desc: '세무, 주식, ISA, 대출 독자 빈출 질문 TOP 20 & 1:1 질문하기',
    badge: 'Q&A FAQ',
    color: '#8b5cf6',
    bg: '#f3e8ff',
    icon: '💡',
  },
  {
    href: '/category/expats',
    name: '외국인 금융·생활 가이드',
    desc: '외국인 계좌개설, 건강보험료 환급, 연말정산 19% 단일세율',
    badge: 'FOR EXPATS',
    color: '#059669',
    bg: '#ecfdf5',
    icon: '🌏',
  },
];
---

<BaseLayout
  title="메가머니모멘텀(MegaMoneyMomentum) | 2026 대한민국 금융·세무·정책 나침반"
  description="국세청, 기획재정부, 금융감독원 공공데이터 기반 팩트체크 금융 미디어. 연말정산 절세, 중개형 ISA 비과세 혜택, 2026 정부지원금 신청 자격 총정리."
>
  <!-- Hero Section -->
  <section class="container" style="text-align: center; padding: 2rem 0 3.5rem 0;">
    <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--primary-light); color: var(--primary); padding: 0.4rem 1rem; border-radius: var(--radius-full); font-size: 0.85rem; font-weight: 700; margin-bottom: 1.25rem;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18h6"></path>
        <path d="M10 22h4"></path>
        <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"></path>
      </svg>
      <span>2026 최신 세법 및 금융 정책 완벽 반영</span>
    </div>
    <h1 style="font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.25; margin-bottom: 1.25rem; color: var(--text-main);">
      어려운 금융·세무·정책 정보,<br />
      <span style="color: var(--primary);">팩트와 데이터</span>로 가장 명쾌하게.
    </h1>
    <p style="font-size: 1.15rem; color: var(--text-muted); max-width: 680px; margin: 0 auto 2.5rem auto; line-height: 1.7; word-break: keep-all;">
      국세청, 금융감독원 공식 고시를 직접 검증하여 광고성 정보 없이 실질적으로 내 돈을 지키고 불리는 절세 및 지원금 가이드를 제공합니다.
    </p>

    <!-- 6 Core Categories Grid (3x2) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-top: 1.5rem;">
      {
        categories.map((c) => (
          <a
            href={`/category/${c.slug}`}
            style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.25rem; text-align: left; transition: all 0.2s ease; box-shadow: var(--shadow-sm);"
            class="category-hover-card"
          >
            <div style={`width: 2.75rem; height: 2.75rem; border-radius: var(--radius-md); background: ${c.bg}; color: ${c.color}; display: flex; align-items: center; justify-content: center; margin-bottom: 0.75rem;`}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={c.iconPath} />
              </svg>
            </div>
            <h2 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.35rem;">
              {c.name}
            </h2>
            <p style="font-size: 0.825rem; color: var(--text-muted); line-height: 1.5; margin: 0;">
              {c.desc}
            </p>
          </a>
        ))
      }
    </div>

    <!-- 3 Interactive Special Hubs Row (3x1) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-top: 1.25rem;">
      {
        specialHubs.map((h) => (
          <a
            href={h.href}
            style={`background: ${h.bg}; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.25rem; text-align: left; transition: all 0.2s ease; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;`}
            class="category-hover-card"
          >
            <div>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
                <span style="font-size: 1.5rem;">{h.icon}</span>
                <span style={`font-size: 0.75rem; font-weight: 800; color: ${h.color}; background: var(--bg-card); padding: 0.2rem 0.5rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);`}>
                  {h.badge}
                </span>
              </div>
              <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.35rem;">
                {h.name}
              </h3>
              <p style="font-size: 0.825rem; color: var(--text-muted); line-height: 1.5; margin: 0;">
                {h.desc}
              </p>
            </div>
            <div style={`margin-top: 1rem; font-size: 0.825rem; font-weight: 700; color: ${h.color}; display: flex; align-items: center; gap: 0.25rem;`}>
              <span>바로가기</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Interactive Calculator Section (Information Gain) -->
  <section class="container" style="margin-bottom: 3rem;">
    <TaxSavingsCalculator />
  </section>

  <!-- Latest Articles Section -->
  <section class="container">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 2px solid var(--border-color);">
      <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-main); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z"></path>
        </svg>
        실시간 금융·세무 심층 가이드
      </h2>
      <span style="font-size: 0.875rem; color: var(--text-muted); font-weight: 600;">총 {koPosts.length}편의 검증된 리포트</span>
    </div>

    <div class="blog-grid">
      {
        sortedPosts.map((post) => (
          <article class="blog-card">
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class={`badge-category badge-${post.data.category}`}>
                  {post.data.categoryName}
                </span>
                <span>•</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'short', day: 'numeric' }).format(post.data.pubDate)}
                </time>
              </div>
              <h3 class="blog-card-title">
                <a href={`/blog/${post.slug}`} style="color: inherit;">
                  {post.data.title}
                </a>
              </h3>
              <p class="blog-card-desc">{post.data.description}</p>
              <div class="blog-card-footer">
                <a href={`/blog/${post.slug}`} style="display: inline-flex; align-items: center; gap: 0.35rem; color: var(--primary);">
                  상세 가이드 읽기 
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
                <span style="font-size: 0.8rem; color: var(--text-light); display: inline-flex; align-items: center; gap: 0.3rem;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  {post.data.readingTime}
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .category-hover-card:hover {
    transform: translateY(-3px);
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }
</style>
