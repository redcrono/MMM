---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  articleDate?: Date;
  updatedDate?: Date;
  articleAuthor?: string;
  category?: string;
  lang?: string;
  noindex?: boolean;
}

const currentPath = Astro.url.pathname;
const autoIsEn =
  currentPath.startsWith('/en') ||
  currentPath.includes('/en-') ||
  currentPath.includes('/korea-') ||
  currentPath.includes('/open-korea-') ||
  currentPath.includes('/best-korea-') ||
  currentPath.includes('-expats') ||
  currentPath.includes('-foreigners') ||
  currentPath.includes('travel-cards');

const {
  title,
  description,
  image,
  articleDate,
  updatedDate,
  articleAuthor,
  category,
  lang = autoIsEn ? 'en' : 'ko',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      articleDate={articleDate}
      updatedDate={updatedDate}
      articleAuthor={articleAuthor}
      category={category}
      noindex={noindex}
    />
  </head>
  <body>
    <Header />
    <main id="main-content" style="flex: 1; padding: 2.5rem 0 4rem 0;">
      <slot />
    </main>
    <Footer />
  </body>
</html>
